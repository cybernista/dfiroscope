<Window x:Class="ProcInsider.WindowsSettingsTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProcInsider.ViewModels"
        Title="{Binding Title}" Width="630" SizeToContent="Height" MaxHeight="780"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer x:Name="TransferContent" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel>
        <StackPanel Visibility="{Binding HasBackupPicker, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12">
            <TextBlock Text="Saved configuration" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DockPanel>
                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse..." Padding="10,3" Margin="8,0,0,0" Click="Browse_Click"/>
                <ComboBox x:Name="BackupPicker" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                          DisplayMemberPath="Label" MinHeight="28" AutomationProperties.Name="Saved configuration to restore" SelectionChanged="Backup_SelectionChanged"/>
            </DockPanel>
            <TextBlock Text="{Binding DiscoveryStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#555555"/>
        </StackPanel>
        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Border x:Name="ImpactWarning" Background="#FFF4DB" BorderBrush="#BA8222" BorderThickness="1" Padding="10" Margin="0,0,0,12"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Review the impact on this computer" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Text="{x:Static vm:HostMonitoringConfigurationViewModel.ComputerConfigurationWarning}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Areas}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsEnabled="{Binding IsAvailable}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,0,8"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <CheckBox x:Name="Acknowledgement" IsChecked="False" Margin="0,10,0,10"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="I am authorized to change this computer and understand the effects and recovery limits described above." TextWrapping="Wrap"/>
        </CheckBox>
       </StackPanel>
      </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="AcceptButton" Content="{Binding ActionLabel}" Padding="12,3" Margin="0,0,8,0" Click="Accept_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanRestore}" Value="False">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="True"/>
                                    <Condition Binding="{Binding IsChecked, ElementName=Acknowledgement}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="False"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Cancel" IsCancel="True" Padding="12,3"/>
        </StackPanel>
    </Grid>
</Window>
