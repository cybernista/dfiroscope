<Window x:Class="ProcInsider.AgentMonitoringStatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="Monitoring Status"
        Width="760"
        Height="560"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding DisplayName}"
                       FontWeight="SemiBold"
                       FontSize="14"
                       TextWrapping="Wrap"/>
            <TextBox Foreground="#555555"
                     IsReadOnly="True"
                     IsTabStop="False"
                     BorderThickness="0"
                     Background="Transparent"
                     TextWrapping="Wrap">
                <TextBox.Text>
                    <MultiBinding Mode="OneWay" StringFormat="ID {0}; host {1}; {2}; {3}">
                        <Binding Path="AgentId" Mode="OneWay"/>
                        <Binding Path="HostId" Mode="OneWay"/>
                        <Binding Path="ViewerConnectionDisplay" Mode="OneWay"/>
                        <Binding Path="DeploymentStateDisplay" Mode="OneWay"/>
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Monitoring check"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding LastConfigurationCheckSummary, Mode=OneWay}"
                         FontWeight="SemiBold"
                         IsReadOnly="True"
                         IsTabStop="False"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"/>
                <TextBox Text="{Binding LastConfigurationCheckDetails, Mode=OneWay}"
                         Foreground="#555555"
                         IsReadOnly="True"
                         IsTabStop="False"
                         AcceptsReturn="True"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"
                         MinHeight="56"
                         Margin="0,3,0,12"/>

                <TextBlock Text="Saved configuration"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBox Foreground="#555555"
                         IsReadOnly="True"
                         IsTabStop="False"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"
                         Margin="0,0,0,12">
                    <TextBox.Text>
                        <MultiBinding Mode="OneWay" StringFormat="Monitoring config {0} / {1}">
                            <Binding Path="ConfigurationVersion" Mode="OneWay"/>
                            <Binding Path="ConfigurationHashDisplay" Mode="OneWay"/>
                        </MultiBinding>
                    </TextBox.Text>
                </TextBox>

                <TextBlock Text="Original baseline"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding MonitoringOriginalStateDisplay, Mode=OneWay}"
                         Foreground="#555555"
                         FontWeight="SemiBold"
                         IsReadOnly="True"
                         IsTabStop="False"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"/>
                <TextBox Text="{Binding MonitoringOriginalStateSummary, Mode=OneWay}"
                         Foreground="#555555"
                         IsReadOnly="True"
                         IsTabStop="False"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"
                         Margin="0,3,0,0"/>
                <TextBox Text="{Binding MonitoringOriginalStateDetails, Mode=OneWay}"
                         Foreground="#555555"
                         IsReadOnly="True"
                         IsTabStop="False"
                         AcceptsReturn="True"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"
                         MinHeight="72"
                         Margin="0,3,0,12"/>

                <TextBlock Text="Last error"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding LastError, Mode=OneWay}"
                         Foreground="#7A1E1E"
                         IsReadOnly="True"
                         IsTabStop="False"
                         AcceptsReturn="True"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Configure Monitoring"
                    Command="{Binding Commands.ConfigureAgentMonitoringCommand, ElementName=Root}"
                    CommandParameter="{Binding}"
                    IsEnabled="{Binding Commands.IsAgentViewerConnected, ElementName=Root}"
                    MinWidth="130"
                    Padding="10,3"
                    Margin="0,0,6,0"/>
            <Button Content="Revert to original config"
                    Command="{Binding Commands.ReverseAgentMonitoringDeploymentCommand, ElementName=Root}"
                    CommandParameter="{Binding}"
                    MinWidth="140"
                    Padding="10,3"
                    Margin="0,0,6,0"/>
            <Button Content="Close"
                    MinWidth="76"
                    Padding="10,3"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
