<Window x:Class="ProcInsider.AgentHealthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="Agent Health"
        Width="860"
        Height="720"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding StatusLine}"
                       FontWeight="SemiBold"
                       FontSize="14"
                       TextWrapping="Wrap"/>
            <TextBlock Text="Refreshing automatically every second."
                       Foreground="#666666"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Agent status"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <DataGrid ItemsSource="{Binding SummaryRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          MaxHeight="220"
                          Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="160"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Live capture statistics (current state; totals from current/last run)"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <DataGrid ItemsSource="{Binding MetricRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          MaxHeight="150"
                          Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="150"/>
                        <DataGridTextColumn Header="Written total" Binding="{Binding Written}" Width="100"/>
                        <DataGridTextColumn Header="Now" Binding="{Binding RecordsPerSecond}" Width="80"/>
                        <DataGridTextColumn Header="Queued" Binding="{Binding Queued}" Width="110"/>
                        <DataGridTextColumn Header="Dropped total" Binding="{Binding Dropped}" Width="100"/>
                        <DataGridTextColumn Header="Failure total" Binding="{Binding Failures}" Width="95"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Sources"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <DataGrid ItemsSource="{Binding SourceRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          MaxHeight="220"
                          Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="105"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="Written total" Binding="{Binding Written}" Width="100"/>
                        <DataGridTextColumn Header="Now" Binding="{Binding RecordsPerSecond}" Width="75"/>
                        <DataGridTextColumn Header="Queued" Binding="{Binding Queued}" Width="80"/>
                        <DataGridTextColumn Header="Dropped total" Binding="{Binding Dropped}" Width="100"/>
                        <DataGridTextColumn Header="Failure total" Binding="{Binding Failures}" Width="95"/>
                        <DataGridTextColumn Header="Dedup totals" Binding="{Binding Dedup}" Width="135"/>
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Health detail"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding Detail, Mode=OneWay, TargetNullValue='No health detail was reported.'}"
                         IsReadOnly="True"
                         IsTabStop="False"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="64"
                         MaxHeight="140"
                         Margin="0,0,0,12"/>

                <StackPanel Visibility="{Binding IsSqliteDiagnosticsPublished, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="SQLite benchmark"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <WrapPanel Margin="0,0,0,5">
                    <Button Content="Start Benchmark"
                            Command="{Binding Commands.StartAgentSqliteBenchmarkCommand, ElementName=Root}"
                            CommandParameter="{Binding Agent}"
                            Padding="8,2"
                            Margin="0,0,4,0"/>
                    <Button Content="Cancel Benchmark"
                            Command="{Binding Commands.CancelAgentSqliteBenchmarkCommand, ElementName=Root}"
                            CommandParameter="{Binding Agent}"
                            Padding="8,2"
                            Margin="0,0,4,0"/>
                </WrapPanel>
                <TextBox Text="{Binding Agent.BenchmarkPreflightSummary, Mode=OneWay, TargetNullValue='Benchmark preflight has not run.'}"
                         Foreground="#555555"
                         IsReadOnly="True"
                         IsTabStop="False"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"
                         Margin="0,0,0,3"/>
                <TextBox Text="{Binding Agent.BenchmarkStatusSummary, Mode=OneWay, TargetNullValue='No benchmark has run.'}"
                         FontWeight="SemiBold"
                         IsReadOnly="True"
                         IsTabStop="False"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"
                         Margin="0,0,0,3"/>
                <TextBox Text="{Binding Agent.BenchmarkStatusDetails, Mode=OneWay, TargetNullValue=''}"
                         IsReadOnly="True"
                         IsTabStop="False"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"
                         MaxHeight="90"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,4"/>
                <DataGrid ItemsSource="{Binding Agent.BenchmarkResultRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          EnableRowVirtualization="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          FontSize="11"
                          MaxHeight="180"
                          Margin="0,0,0,4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="210"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Benchmark DB" VerticalAlignment="Center" Margin="0,0,6,3"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Agent.BenchmarkDatabasePath, Mode=OneWay, TargetNullValue=''}" IsReadOnly="True" Margin="0,0,0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Report" VerticalAlignment="Center" Margin="0,0,6,3"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Agent.BenchmarkReportPath, Mode=OneWay, TargetNullValue=''}" IsReadOnly="True" Margin="0,0,0,3"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="JSON report" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Agent.BenchmarkJsonReportPath, Mode=OneWay, TargetNullValue=''}" IsReadOnly="True"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="SQLite Performance"
                    Command="{Binding Commands.ShowSqlitePerformanceCommand, ElementName=Root}"
                    CommandParameter="{Binding Agent}"
                    Visibility="{Binding IsSqliteDiagnosticsPublished, Converter={StaticResource BoolToVisibilityConverter}}"
                    MinWidth="126"
                    Padding="10,3"
                    Margin="0,0,8,0"/>
            <Button Content="Close"
                    MinWidth="76"
                    Padding="10,3"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
