<Window x:Class="ProcInsider.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProcInsider"
        xmlns:models="clr-namespace:ProcInsider.Models;assembly=DFIRoscope.Core"
        xmlns:viewerModels="clr-namespace:ProcInsider.Models"
        xmlns:vm="clr-namespace:ProcInsider.ViewModels"
        xmlns:converters="clr-namespace:ProcInsider.Converters"
        xmlns:aiViews="clr-namespace:ProcInsider.Views.Features.Ai"
        xmlns:memoryViews="clr-namespace:ProcInsider.Views.Features.Memory"
        xmlns:networkViews="clr-namespace:ProcInsider.Views.Features.Network"
        xmlns:infrastructureViews="clr-namespace:ProcInsider.Features.Infrastructure"
        xmlns:explorerViews="clr-namespace:ProcInsider.Views.Explorer"
        xmlns:agentViews="clr-namespace:ProcInsider.Views.Features.Agents"
        xmlns:searchViews="clr-namespace:ProcInsider.Views.Features.Search"
        mc:Ignorable="d"
        Title="{x:Static models:ProductIdentity.DisplayName}"
        Icon="Assets/DFIRoscope.Live.ico"
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <converters:ProcessGridSelectionConverter x:Key="ProcessGridSelectionConverter"/>
        <local:FeaturePublicationBindingProxy x:Key="FeaturePublicationProxy"
                                              Data="{Binding FeaturePublication}"/>

        <DataTemplate x:Key="InfrastructureCaseExplorerTemplate">
            <infrastructureViews:InfrastructureCaseWorkspaceView/>
        </DataTemplate>
        <DataTemplate x:Key="InfrastructureCaseDataTemplate">
            <infrastructureViews:InfrastructureCaseWorkspaceDataView/>
        </DataTemplate>

        <!-- Style for exited processes (grayed out) -->
        <Style x:Key="ExitedRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoadingPlaceholder}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="ToolTip" Value="This row is loading; process actions are unavailable."/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExited}" Value="True">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style for filter text boxes -->
        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ScopedActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="62"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ScopedIncludeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ScopedActionButtonStyle}">
            <Setter Property="Background" Value="#FFE7F5EC"/>
            <Setter Property="BorderBrush" Value="#FF7BB58E"/>
            <Setter Property="Foreground" Value="#FF145A2A"/>
        </Style>

        <Style x:Key="ScopedExcludeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ScopedActionButtonStyle}">
            <Setter Property="Background" Value="#FFFBEAEA"/>
            <Setter Property="BorderBrush" Value="#FFD48A8A"/>
            <Setter Property="Foreground" Value="#FF7A1E1E"/>
        </Style>

        <Style x:Key="ScopedResetButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ScopedActionButtonStyle}">
            <Setter Property="Background" Value="#FFF3F3F3"/>
            <Setter Property="BorderBrush" Value="#FFBEBEBE"/>
            <Setter Property="Foreground" Value="#FF333333"/>
        </Style>

        <Style x:Key="ExplorerGreenButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFBEBEBE"/>
            <Setter Property="Foreground" Value="#FF555555"/>
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasGreenIncludedDescendant}" Value="True">
                    <Setter Property="Background" Value="#FFE7F5EC"/>
                    <Setter Property="BorderBrush" Value="#FF7BB58E"/>
                    <Setter Property="Foreground" Value="#FF145A2A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGreenIncludedDirectly}" Value="True">
                    <Setter Property="Background" Value="#FF188A42"/>
                    <Setter Property="BorderBrush" Value="#FF0E6B31"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolbarTextButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Style for column headers with sort indicator -->
        <Style x:Key="SortableHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:ExplorerNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <Border Padding="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScopeSelected}" Value="True">
                                <Setter Property="Background" Value="#FFE7F0FA"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="{Binding ScopeGlyph}"
                            Style="{StaticResource ExplorerGreenButtonStyle}"
                            ToolTip="{Binding ScopeStateDescription}"
                            Command="{Binding DataContext.ToggleExplorerGreenScopeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding DisplayName}"
                               ToolTip="{Binding Description}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FF000000"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScopeSelected}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Application Menu -->
        <Menu Grid.Row="0" IsEnabled="{Binding IsStandaloneWorkspaceActive}">
            <MenuItem Header="_Staging">
                <MenuItem Header="Open Capture..."
                          Command="{Binding OpenCaptureCommand}"/>
                <MenuItem Header="Refresh from db"
                          Command="{Binding RefreshViewFromStagingCommand}"/>
                <MenuItem Header="Analysis _view mode"
                          AutomationProperties.Name="Analysis view mode">
                    <MenuItem Header="_Manual / Pinned"
                              AutomationProperties.Name="Manual or pinned analysis view mode"
                              AutomationProperties.HelpText="Keeps the current coherent viewer snapshot until Refresh from db is requested."
                              IsCheckable="True"
                              IsChecked="{Binding IsManualSnapshotMode, Mode=OneWay}"
                              Command="{Binding SelectManualSnapshotModeCommand}"/>
                    <MenuItem Header="_Follow Capture"
                              AutomationProperties.Name="Follow Capture analysis view mode"
                              AutomationProperties.HelpText="Opt in to non-modal coherent snapshot updates no more often than the selected interval."
                              IsCheckable="True"
                              IsChecked="{Binding IsFollowCaptureMode, Mode=OneWay}"
                              Command="{Binding SelectFollowCaptureModeCommand}"/>
                </MenuItem>
                <MenuItem Header="Follow _interval"
                          AutomationProperties.Name="Follow Capture interval"
                          AutomationProperties.HelpText="Viewer follow interval; independent from agent acquisition and enrichment intervals."
                          IsEnabled="{Binding IsSnapshotFollowIntervalEnabled}">
                    <MenuItem Header="_1 minute"
                              IsCheckable="True"
                              IsChecked="{Binding IsFollowIntervalOneMinute, Mode=OneWay}"
                              Command="{Binding SelectSnapshotFollowIntervalCommand}"
                              CommandParameter="1"/>
                    <MenuItem Header="_2 minutes"
                              IsCheckable="True"
                              IsChecked="{Binding IsFollowIntervalTwoMinutes, Mode=OneWay}"
                              Command="{Binding SelectSnapshotFollowIntervalCommand}"
                              CommandParameter="2"/>
                    <MenuItem Header="_5 minutes"
                              IsCheckable="True"
                              IsChecked="{Binding IsFollowIntervalFiveMinutes, Mode=OneWay}"
                              Command="{Binding SelectSnapshotFollowIntervalCommand}"
                              CommandParameter="5"/>
                    <MenuItem Header="1_0 minutes"
                              IsCheckable="True"
                              IsChecked="{Binding IsFollowIntervalTenMinutes, Mode=OneWay}"
                              Command="{Binding SelectSnapshotFollowIntervalCommand}"
                              CommandParameter="10"/>
                </MenuItem>
                <MenuItem Header="Open Capture Location"
                          Command="{Binding OpenSessionFolderCommand}"/>
                <Separator/>
                <MenuItem Header="Clear Viewer State"
                          Command="{Binding ClearCurrentViewerStateCommand}"/>
            </MenuItem>
            <MenuItem Header="_Event Viewer"
                      Visibility="{Binding FeaturePublication.EventTelemetry, Converter={StaticResource BoolToVisibilityConverter}}">
                <MenuItem Header="Open Event Viewer"
                          Command="{Binding OpenEventViewerCommand}"/>
                <Separator/>
                <MenuItem Header="Windows Logs">
                    <MenuItem Header="Application"
                              Command="{Binding OpenEventViewerLogCommand}"
                              CommandParameter="Application"/>
                    <MenuItem Header="System"
                              Command="{Binding OpenEventViewerLogCommand}"
                              CommandParameter="System"/>
                    <MenuItem Header="Security"
                              Command="{Binding OpenEventViewerLogCommand}"
                              CommandParameter="Security"/>
                </MenuItem>
                <MenuItem Header="PowerShell">
                    <MenuItem Header="PowerShell Operational"
                              Command="{Binding OpenEventViewerLogCommand}"
                              CommandParameter="Microsoft-Windows-PowerShell/Operational"/>
                    <MenuItem Header="Windows PowerShell"
                              Command="{Binding OpenEventViewerLogCommand}"
                              CommandParameter="Windows PowerShell"/>
                </MenuItem>
                <MenuItem Header="Sysmon"
                          Command="{Binding OpenEventViewerLogCommand}"
                          CommandParameter="Microsoft-Windows-Sysmon/Operational"/>
                <MenuItem Header="DNS Client"
                          Command="{Binding OpenEventViewerLogCommand}"
                          CommandParameter="Microsoft-Windows-DNS-Client/Operational"/>
                <MenuItem Header="Other Operational Logs">
                    <MenuItem Header="WMI Activity"
                              Command="{Binding OpenEventViewerLogCommand}"
                              CommandParameter="Microsoft-Windows-WMI-Activity/Operational"/>
                    <MenuItem Header="Task Scheduler"
                              Command="{Binding OpenEventViewerLogCommand}"
                              CommandParameter="Microsoft-Windows-TaskScheduler/Operational"/>
                    <MenuItem Header="Windows Defender"
                              Command="{Binding OpenEventViewerLogCommand}"
                              CommandParameter="Microsoft-Windows-Windows Defender/Operational"/>
                    <MenuItem Header="Terminal Services Local Session Manager"
                              Command="{Binding OpenEventViewerLogCommand}"
                              CommandParameter="Microsoft-Windows-TerminalServices-LocalSessionManager/Operational"/>
                    <MenuItem Header="Remote Desktop Services RdpCoreTS"
                              Command="{Binding OpenEventViewerLogCommand}"
                              CommandParameter="Microsoft-Windows-RemoteDesktopServices-RdpCoreTS/Operational"/>
                    <MenuItem Header="Code Integrity"
                              Command="{Binding OpenEventViewerLogCommand}"
                              CommandParameter="Microsoft-Windows-CodeIntegrity/Operational"/>
                    <Separator/>
                    <MenuItem Header="AppLocker EXE and DLL"
                              Command="{Binding OpenEventViewerLogCommand}"
                              CommandParameter="Microsoft-Windows-AppLocker/EXE and DLL"/>
                    <MenuItem Header="AppLocker MSI and Script"
                              Command="{Binding OpenEventViewerLogCommand}"
                              CommandParameter="Microsoft-Windows-AppLocker/MSI and Script"/>
                    <MenuItem Header="AppLocker Packaged App Deployment"
                              Command="{Binding OpenEventViewerLogCommand}"
                              CommandParameter="Microsoft-Windows-AppLocker/Packaged app-Deployment"/>
                    <MenuItem Header="AppLocker Packaged App Execution"
                              Command="{Binding OpenEventViewerLogCommand}"
                              CommandParameter="Microsoft-Windows-AppLocker/Packaged app-Execution"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Artifact Enrichment"
                      Visibility="{Binding FeaturePublication.ArtifactEnrichmentMenu, Converter={StaticResource BoolToVisibilityConverter}}">
                <MenuItem Header="Start Artifact Enrichment"
                          Command="{Binding StartArtifactEnrichmentCommand}"/>
                <MenuItem Header="Stop Artifact Enrichment"
                          Command="{Binding StopArtifactEnrichmentCommand}"/>
                <MenuItem Header="Queue Selected Process Dump"
                          Command="{Binding QueueSelectedProcessDumpCommand}"
                          Visibility="{Binding FeaturePublication.DumpsAndPeAnalysis, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Separator/>
                <MenuItem Header="Analyze Selected Process Image"
                          Command="{Binding AnalyzeSelectedProcessImageCommand}"
                          Visibility="{Binding FeaturePublication.DumpsAndPeAnalysis, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <MenuItem Header="Analyze Selected Dump as PE"
                          Command="{Binding AnalyzeSelectedDumpPeCommand}"
                          Visibility="{Binding FeaturePublication.DumpsAndPeAnalysis, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Separator/>
                <MenuItem Header="Import NTFS / Prefetch File..."
                          Command="{Binding QueueArtifactFileImportCommand}"
                          Visibility="{Binding FeaturePublication.FilesystemArtifacts, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <MenuItem Header="Import NTFS / Prefetch Folder..."
                          Command="{Binding QueueArtifactFolderImportCommand}"
                          Visibility="{Binding FeaturePublication.FilesystemArtifacts, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Separator/>
                <MenuItem Header="Collect Modules"
                          Visibility="{Binding FeaturePublication.ModulesAndHandles, Converter={StaticResource BoolToVisibilityConverter}}"
                          IsCheckable="True"
                          StaysOpenOnClick="True"
                          IsChecked="{Binding IsModuleCollectionEnabled, Mode=TwoWay}"/>
                <MenuItem Header="Collect Handles"
                          Visibility="{Binding FeaturePublication.ModulesAndHandles, Converter={StaticResource BoolToVisibilityConverter}}"
                          IsCheckable="True"
                          StaysOpenOnClick="True"
                          IsChecked="{Binding IsHandleCollectionEnabled, Mode=TwoWay}"/>
            </MenuItem>
            <MenuItem Header="_System Memory"
                      Visibility="{Binding FeaturePublication.SystemMemoryAndVolatility, Converter={StaticResource BoolToVisibilityConverter}}">
                <MenuItem Header="Dump System Memory"
                          Command="{Binding DumpSystemMemoryCommand}"/>
                <MenuItem Header="Import Memory Image..."
                          Command="{Binding QueueMemoryImageImportCommand}"/>
                <MenuItem Header="Run Volatility On Selected Image"
                          Command="{Binding QueueSelectedMemoryImageVolatilityAnalysisCommand}"/>
            </MenuItem>
            <MenuItem Header="_AI"
                      Visibility="{Binding FeaturePublication.AiAssistance, Converter={StaticResource BoolToVisibilityConverter}}">
                <MenuItem Header="Open AI Investigation"
                          Command="{Binding OpenAiInvestigationTabCommand}"/>
                <MenuItem Header="Run AI on Selected Process"
                          Command="{Binding AiInvestigationViewModel.RunInvestigationCommand}"/>
                <Separator/>
                <MenuItem Header="Save AI Settings"
                          Command="{Binding AiInvestigationViewModel.SaveSettingsCommand}"/>
                <MenuItem Header="Test AI Connection"
                          Command="{Binding AiInvestigationViewModel.TestConnectionCommand}"/>
                <MenuItem Header="Clear Saved API Key"
                          Command="{Binding AiInvestigationViewModel.ClearApiKeyCommand}"/>
            </MenuItem>
            <MenuItem Header="_Security Monitoring"
                      Visibility="{Binding FeaturePublication.SecurityMonitoringConfiguration, Converter={StaticResource BoolToVisibilityConverter}}">
                <MenuItem Header="Check Host Monitoring Through Agent..."
                          ToolTip="Run read-only monitoring prerequisite and status checks through the connected local agent."
                          Command="{Binding CheckAgentMonitoringConfigurationCommand}"/>
                <MenuItem Header="Configure Host Monitoring Through Agent..."
                          ToolTip="Save and explicitly deploy selected Sysmon, PowerShell, and related monitoring actions through the connected elevated local agent."
                          Command="{Binding ConfigureAgentMonitoringCommand}"/>
                <MenuItem Header="Revert Host Monitoring Through Agent"
                          ToolTip="Restore the original host monitoring state captured by the connected elevated local agent."
                          Command="{Binding ReverseAgentMonitoringDeploymentCommand}"/>
                <Separator/>
                <MenuItem Header="Security Monitoring Policy Profiles (Read-only)"
                          ItemsSource="{Binding SecurityMonitoringPolicyProfiles}"
                          IsEnabled="{Binding HasSecurityMonitoringPolicyProfiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="{x:Type MenuItem}">
                            <Setter Property="Header" Value="{Binding DisplayName}"/>
                            <Setter Property="ToolTip" Value="{Binding Description}"/>
                            <Setter Property="Command"
                                    Value="{Binding DataContext.OpenSecurityMonitoringPolicyProfileCommand, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="PowerShell Auditing Profiles (Read-only)"
                          IsEnabled="{Binding HasPowerShellAuditingProfiles}">
                    <MenuItem Header="Verify"
                              ItemsSource="{Binding PowerShellAuditingProfiles}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="{x:Type MenuItem}">
                                <Setter Property="Header" Value="{Binding DisplayName}"/>
                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                                <Setter Property="Command"
                                        Value="{Binding DataContext.VerifyPowerShellAuditingProfileCommand, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"/>
                                <Setter Property="CommandParameter" Value="{Binding}"/>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem Header="Open Profile"
                              ItemsSource="{Binding PowerShellAuditingProfiles}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="{x:Type MenuItem}">
                                <Setter Property="Header" Value="{Binding DisplayName}"/>
                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                                <Setter Property="Command"
                                        Value="{Binding DataContext.OpenPowerShellAuditingProfileCommand, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"/>
                                <Setter Property="CommandParameter" Value="{Binding}"/>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Open Event Log Policy Profile"
                          ToolTip="Open bundled event log sizing and retention profile metadata."
                          ItemsSource="{Binding EventLogPolicyProfiles}"
                          IsEnabled="{Binding HasEventLogPolicyProfiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="{x:Type MenuItem}">
                            <Setter Property="Header" Value="{Binding DisplayName}"/>
                            <Setter Property="ToolTip" Value="{Binding Description}"/>
                            <Setter Property="Command"
                                    Value="{Binding DataContext.OpenEventLogPolicyProfileCommand, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Open Existing PowerShell Transcript Folder"
                          Command="{Binding OpenTranscriptFolderCommand}"/>
                <MenuItem Header="Open Event Viewer"
                          Command="{Binding OpenEventViewerCommand}"/>
                <MenuItem Header="Open Existing Legacy Monitoring Install Log"
                          Command="{Binding OpenMonitoringInstallLogCommand}"/>
                <Separator/>
                <MenuItem Header="Refresh Security Monitoring Status"
                          Command="{Binding RefreshSysmonStatusCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1" Background="#F0F0F0" IsEnabled="{Binding IsStandaloneWorkspaceActive}">
            <Button Style="{StaticResource ToolbarTextButtonStyle}"
                    Command="{Binding AddAgentCommand}"
                    Visibility="{Binding FeaturePublication.AgentsAndCapture, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button.ToolTip>
                    <TextBlock>
                        <Run Text="Securely reconnect an existing or add and start a local "/>
                        <Run Text="{x:Static models:ProductIdentity.AgentDisplayName}"/>
                        <Run Text=" for this capture"/>
                    </TextBlock>
                </Button.ToolTip>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Connect / Add Agent"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarTextButtonStyle}"
                    Command="{Binding ReconnectRunningLocalAgentCommand}"
                    Visibility="{Binding FeaturePublication.AgentsAndCapture, Converter={StaticResource BoolToVisibilityConverter}}"
                    ToolTip="Authenticate and recover the exact verified local agent/workspace from its protected lease without starting another process">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Reconnect Local Agent"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarTextButtonStyle}"
                    Command="{Binding OpenCaptureCommand}">
                <Button.ToolTip>
                    <TextBlock>
                        <Run Text="Open a "/>
                        <Run Text="{x:Static models:ProductIdentity.DisplayName}"/>
                        <Run Text=" capture by selecting its session.json manifest"/>
                    </TextBlock>
                </Button.ToolTip>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Open Capture"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarTextButtonStyle}"
                    Command="{Binding OpenSessionFolderCommand}"
                    ToolTip="Open the active capture/session root in Explorer without changing loaded data">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE838;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Open Capture Location"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarTextButtonStyle}"
                    Command="{Binding RefreshViewFromStagingCommand}"
                    ToolTip="Create a viewer snapshot from the active live SQLite session">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Refresh from DB"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding ConnectedAgentStatusMessage, Mode=OneWay}"
                       Visibility="{Binding FeaturePublication.AgentsAndCapture, Converter={StaticResource BoolToVisibilityConverter}}"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       ToolTip="Counts only fresh authenticated viewer-agent connections for the active workspace"/>
        </ToolBar>

        <!-- Main Content: forensic workspace shell -->
        <Grid Grid.Row="2"
              Visibility="{Binding IsInfrastructureWorkspaceActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="720"/>
            </Grid.ColumnDefinitions>

            <!-- Explorer window -->
            <Border Grid.Column="0"
                    BorderBrush="#FFD0D0D0"
                    BorderThickness="0,0,1,0"
                    Background="#FFFAFAFA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFE8E8E8" Padding="7,4">
                        <TextBlock Text="Explorer"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <TabControl Grid.Row="1"
                                 ItemsSource="{Binding ExplorerTabs}"
                                 SelectedItem="{Binding SelectedExplorerTab, Mode=TwoWay}"
                                 Margin="4">
                        <TabControl.Resources>
                            <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
                                <explorerViews:ExploreView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:AgentsViewModel}">
                                <agentViews:ExplorerAgentsView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SigmaViewModel}">
                                <searchViews:ExplorerSigmaView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:MainViewModel}">
                                <aiViews:ExplorerAiView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:NetworkCapturesViewModel}">
                                <networkViews:ExplorerNetworkView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:MemoryInvestigationViewModel}">
                                <memoryViews:ExplorerMemoryView/>
                            </DataTemplate>
                        </TabControl.Resources>
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Header}"/>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding Content}"/>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>

                    <TextBlock Grid.Row="2"
                               Text="{Binding ExplorerViewModel.StatusMessage}"
                               Padding="6,4"
                               Foreground="#555555"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#CCCCCC"
                          Cursor="SizeWE"
                          ShowsPreview="True"/>

            <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>   <!-- Top: process listing -->
                <RowDefinition Height="8"/>    <!-- Horizontal splitter -->
                <RowDefinition Height="3*"/>   <!-- Bottom: tabs + properties -->
            </Grid.RowDefinitions>

            <!-- Top: Process Tree + Selected Info + Filters -->
            <Grid Grid.Row="0"
                  Visibility="{Binding FeaturePublication.ProcessListing, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title -->
                    <RowDefinition Height="Auto"/> <!-- Selected Process Info -->
                    <RowDefinition Height="Auto"/> <!-- Filters Expander -->
                    <RowDefinition Height="*"/>   <!-- DataGrid -->
                </Grid.RowDefinitions>

                <!-- Listing window -->
                <Border Grid.Row="0" Background="#E8E8E8" Padding="5,3">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Listing - Process Tree (click headers to sort, type in boxes to filter)"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ProcessListingStatus}"
                                   Margin="12,0,0,0"
                                   HorizontalAlignment="Right"
                                   Foreground="#555555"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ProcessListingStatus}"/>
                    </DockPanel>
                </Border>

                <!-- Selected Process Info (moved to top area) -->
                <Border Grid.Row="1" Background="#F7F7F7" Padding="6,3">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="{Binding BookmarkSelectedProcessLabel}"
                                Command="{Binding ToggleSelectedProcessBookmarkCommand}"
                                Style="{StaticResource ScopedResetButtonStyle}"
                                ToolTip="Toggle a durable process bookmark."
                                Margin="8,0,0,0"/>
                        <TextBlock FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="Selected: "/>
                            <Run Text="{Binding SelectedProcess.ProcessName, FallbackValue='(none)', Mode=OneWay}"
                                 FontWeight="Bold"/>
                            <Run Text=" (PID: "/>
                            <Run Text="{Binding SelectedProcess.ProcessId, FallbackValue='-', Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- Filters Expander (moved here) -->
                <Border Grid.Row="2" Background="#F5F5F5" Padding="5">
                    <Expander Header="Column Filters" IsExpanded="True">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Top"
                                    HorizontalAlignment="Right"
                                    Content="Clear Listing Filters"
                                    Command="{Binding ClearFiltersCommand}"
                                    ToolTip="Clear Listing column filters. Explorer green selection is unchanged."
                                    Padding="8,4"
                                    Margin="0,0,5,4"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <WrapPanel Orientation="Horizontal">
                                    <StackPanel Margin="5,2">
                                        <TextBlock Text="Process Name" FontSize="10"/>
                                        <TextBox Text="{Binding FilterProcessName, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="120" Style="{StaticResource FilterTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,2">
                                        <TextBlock Text="PID" FontSize="10"/>
                                        <TextBox Text="{Binding FilterPid, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="60" Style="{StaticResource FilterTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,2">
                                        <TextBlock Text="Parent PID" FontSize="10"/>
                                        <TextBox Text="{Binding FilterParentPid, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="60" Style="{StaticResource FilterTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,2">
                                        <TextBlock Text="Parent Name" FontSize="10"/>
                                        <TextBox Text="{Binding FilterParentProcessName, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="100" Style="{StaticResource FilterTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,2">
                                        <TextBlock Text="Path" FontSize="10"/>
                                        <TextBox Text="{Binding FilterProcessPath, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="120" Style="{StaticResource FilterTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,2">
                                        <TextBlock Text="Command Line" FontSize="10"/>
                                        <TextBox Text="{Binding FilterCommandLine, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="150" Style="{StaticResource FilterTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,2">
                                        <TextBlock Text="User" FontSize="10"/>
                                        <TextBox Text="{Binding FilterUserName, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="100" Style="{StaticResource FilterTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,2">
                                        <TextBlock Text="Status" FontSize="10"/>
                                        <TextBox Text="{Binding FilterStatus, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="70" Style="{StaticResource FilterTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="5,2">
                                        <TextBlock Text="SHA256" FontSize="10"/>
                                        <TextBox Text="{Binding FilterSha256Hash, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="150" Style="{StaticResource FilterTextBoxStyle}"/>
                                    </StackPanel>
                                </WrapPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Expander>
                </Border>

                <!-- Process DataGrid -->
                <DataGrid Grid.Row="3" 
                          x:Name="ProcessDataGrid"
                          ItemsSource="{Binding ProcessesView}"
                          SelectedItem="{Binding SelectedProcess, Mode=TwoWay, Converter={StaticResource ProcessGridSelectionConverter}}"
                          SelectionChanged="ProcessDataGrid_SelectionChanged"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.IsContainerVirtualizable="True"
                          VirtualizingPanel.CacheLength="2"
                          VirtualizingPanel.CacheLengthUnit="Page"
                          ScrollViewer.CanContentScroll="True"
                          RowStyle="{StaticResource ExitedRowStyle}"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          Sorting="ProcessDataGrid_Sorting"
                          ScrollViewer.ScrollChanged="ProcessDataGrid_ScrollChanged"
                          LoadingRow="ProcessDataGrid_LoadingRow"
                          FontSize="12">

                    <DataGrid.Columns>
                        <!-- Process Name (with tree indentation) -->
                        <DataGridTemplateColumn Header="Tree" Width="200" SortMemberPath="Tree"
                                                CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProcessNameDisplay}" 
                                               FontFamily="Consolas" 
                                               ToolTip="{Binding ProcessName}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60" 
                                            CanUserSort="True" SortMemberPath="ProcessId"/>

                        <DataGridTextColumn Header="Parent PID" Binding="{Binding ParentProcessId}" Width="75"
                                            CanUserSort="True" SortMemberPath="ParentProcessId"/>

                        <DataGridTextColumn Header="Parent Name" Binding="{Binding ParentProcessName}" Width="120"
                                            CanUserSort="True" SortMemberPath="ParentProcessName"/>

                        <DataGridTextColumn Header="Path" Binding="{Binding ProcessPath}" Width="200"
                                            CanUserSort="True" SortMemberPath="ProcessPath">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding ProcessPath}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Command Line" Binding="{Binding CommandLine}" Width="250"
                                            CanUserSort="True" SortMemberPath="CommandLine">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding CommandLine}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="120"
                                            CanUserSort="True" SortMemberPath="UserName"/>

                        <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" Width="55"
                                            CanUserSort="True" SortMemberPath="SessionId"/>

                        <DataGridTextColumn Header="Arch" Binding="{Binding Architecture}" Width="50"
                                            CanUserSort="True" SortMemberPath="Architecture"/>

                        <DataGridTextColumn Header="Start Time" Binding="{Binding StartTimeDisplay}" Width="130"
                                            CanUserSort="True" SortMemberPath="StartTimeDisplay"/>

                        <DataGridTextColumn Header="End Time" Binding="{Binding EndTimeDisplay}" Width="130"
                                            CanUserSort="True" SortMemberPath="EndTimeDisplay"/>

                        <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="65"
                                            CanUserSort="True" SortMemberPath="StatusDisplay"/>

                        <DataGridTextColumn Header="Risk Score" Binding="{Binding RiskDisplay}" Width="105"
                                            Visibility="{Binding Data.ProcessRiskScore, Source={StaticResource FeaturePublicationProxy}, Converter={StaticResource BoolToVisibilityConverter}}"
                                            CanUserSort="True" SortMemberPath="RiskScore">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding RiskTooltip}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="CPU Time" Binding="{Binding CpuTime}" Width="95"
                                            CanUserSort="True" SortMemberPath="TotalProcessorTimeTicks"/>

                        <DataGridTextColumn Header="Bytes Read" Binding="{Binding BytesRead}" Width="100"
                                            CanUserSort="True" SortMemberPath="ReadBytes"/>

                        <DataGridTextColumn Header="Bytes Written" Binding="{Binding BytesWritten}" Width="110"
                                            CanUserSort="True" SortMemberPath="WrittenBytes"/>

                        <DataGridTextColumn Header="Mods" Binding="{Binding ModuleSummaryDisplay}" Width="95"
                                            Visibility="{Binding Data.ModulesAndHandles, Source={StaticResource FeaturePublicationProxy}, Converter={StaticResource BoolToVisibilityConverter}}"
                                            CanUserSort="True" SortMemberPath="ModuleCount">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding ModuleSummaryTooltip}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Handles" Binding="{Binding HandleSummaryDisplay}" Width="105"
                                            Visibility="{Binding Data.ModulesAndHandles, Source={StaticResource FeaturePublicationProxy}, Converter={StaticResource BoolToVisibilityConverter}}"
                                            CanUserSort="True" SortMemberPath="HandleCount">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding HandleSummaryTooltip}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Runtime" Binding="{Binding RuntimeEventCount}" Width="70"
                                            Visibility="{Binding Data.EventTelemetry, Source={StaticResource FeaturePublicationProxy}, Converter={StaticResource BoolToVisibilityConverter}}"
                                            CanUserSort="True" SortMemberPath="RuntimeEventCount"/>

                        <DataGridTextColumn Header="ETW" Binding="{Binding EtwEventCount}" Width="55"
                                            Visibility="{Binding Data.EventTelemetry, Source={StaticResource FeaturePublicationProxy}, Converter={StaticResource BoolToVisibilityConverter}}"
                                            CanUserSort="True" SortMemberPath="EtwEventCount"/>

                        <DataGridTextColumn Header="Sec" Binding="{Binding SecurityEventCount}" Width="55"
                                            Visibility="{Binding Data.EventTelemetry, Source={StaticResource FeaturePublicationProxy}, Converter={StaticResource BoolToVisibilityConverter}}"
                                            CanUserSort="True" SortMemberPath="SecurityEventCount"/>

                        <DataGridTextColumn Header="PS" Binding="{Binding PowerShellEventCount}" Width="55"
                                            Visibility="{Binding Data.EventTelemetry, Source={StaticResource FeaturePublicationProxy}, Converter={StaticResource BoolToVisibilityConverter}}"
                                            CanUserSort="True" SortMemberPath="PowerShellEventCount"/>

                        <DataGridTextColumn Header="Other" Binding="{Binding OtherWindowsEventCount}" Width="60"
                                            Visibility="{Binding Data.EventTelemetry, Source={StaticResource FeaturePublicationProxy}, Converter={StaticResource BoolToVisibilityConverter}}"
                                            CanUserSort="True" SortMemberPath="OtherWindowsEventCount"/>

                        <DataGridTextColumn Header="Sysmon" Binding="{Binding SysmonEventCount}" Width="65"
                                            Visibility="{Binding Data.EventTelemetry, Source={StaticResource FeaturePublicationProxy}, Converter={StaticResource BoolToVisibilityConverter}}"
                                            CanUserSort="True" SortMemberPath="SysmonEventCount"/>

                        <DataGridTextColumn Header="Memory" Binding="{Binding MemoryUsage}" Width="80"
                                            CanUserSort="True" SortMemberPath="MemoryUsage"/>

                        <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="150"
                                            CanUserSort="True" SortMemberPath="CompanyName">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding CompanyName}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Description" Binding="{Binding FileDescription}" Width="150"
                                            CanUserSort="True" SortMemberPath="FileDescription">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding FileDescription}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="SHA256 Hash" Binding="{Binding Sha256Hash}" Width="200"
                                            CanUserSort="True" SortMemberPath="Sha256Hash">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Sha256Hash}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Horizontal splitter -->
            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="#CCCCCC" Cursor="SizeNS" ShowsPreview="True"/>

            <!-- Bottom: TabControl (left) and Properties (right) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="400"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="2*" MinWidth="250"/>
                </Grid.ColumnDefinitions>

                <!-- Data window -->
                <Border Grid.Column="0" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FFE8E8E8" Padding="5,3" Margin="0,0,0,4">
                            <TextBlock Text="Data"
                                       FontWeight="SemiBold"/>
                        </Border>

                    <TabControl Grid.Row="1"
                                Margin="0"
                                ItemsSource="{Binding DataTabs}"
                                SelectedItem="{Binding SelectedDataTab, Mode=TwoWay}">
                        <TabControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Header}"/></DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate><ContentControl Content="{Binding Content}"/></DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>

                    </Grid>
                </Border>

                <!-- Vertical splitter -->
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="#CCCCCC" Cursor="SizeWE" ShowsPreview="True" />

                <!-- Details window -->
                <Border Grid.Column="2" Padding="6" Background="#FFF7F7F7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FFE8E8E8" Padding="5,3" Margin="0,0,0,4">
                            <TextBlock Text="Details"
                                       FontWeight="SemiBold"/>
                        </Border>

                    <TabControl Grid.Row="1"
                                SelectedValuePath="Tag"
                                SelectedValue="{Binding SelectedDetailsTabKey, Mode=TwoWay}">
                        <TabItem Header="Object"
                                 Tag="{x:Static viewerModels:ViewerDetailsTabKey.Object}"
                                 DataContext="{Binding InspectorPaneViewModel}">
                            <Grid Margin="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="2*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Margin="0,0,0,6"
                                        Padding="8"
                                        Background="#FFFFFFFF"
                                        BorderBrush="#FFD8D8D8"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding HeaderText}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"/>
                                        <TextBlock Text="{Binding SubtitleText}"
                                                   Margin="0,4,0,0"
                                                   Foreground="#555555"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1">
                                    <TextBlock Margin="12"
                                               Text="{Binding EmptyStateMessage}"
                                               Foreground="#666666"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                    <DataGrid ItemsSource="{Binding Properties}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column"
                                              CanUserReorderColumns="True"
                                              CanUserResizeColumns="True"
                                              CanUserSortColumns="True"
                                              FontSize="11"
                                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="95" SortMemberPath="Group"/>
                                            <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="130" SortMemberPath="Name"/>
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"
                                                                SortMemberPath="Value">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="ToolTip" Value="{Binding Value}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                                <TextBlock Grid.Row="2"
                                           Margin="0,6,0,4"
                                           Text="{Binding ContentHeader}"
                                           FontWeight="SemiBold"
                                           Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <Grid Grid.Row="3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding HasContentSections, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl ItemsSource="{Binding ContentSections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander Header="{Binding DisplayTitle}"
                                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                              Margin="0,0,0,5">
                                                        <Border BorderBrush="#FFD8D8D8"
                                                                BorderThickness="1"
                                                                Padding="4">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Text="{Binding Description}"
                                                                           Foreground="#555555"
                                                                           TextWrapping="Wrap"
                                                                           Margin="2,0,2,4"/>
                                                                <DataGrid Grid.Row="1"
                                                                          ItemsSource="{Binding Rows}"
                                                                          AutoGenerateColumns="False"
                                                                          IsReadOnly="True"
                                                                          HeadersVisibility="Column"
                                                                          GridLinesVisibility="Horizontal"
                                                                          EnableRowVirtualization="True"
                                                                          EnableColumnVirtualization="True"
                                                                          VirtualizingPanel.IsVirtualizing="True"
                                                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                                                          CanUserSortColumns="True"
                                                                          CanUserResizeColumns="True"
                                                                          MinHeight="72"
                                                                          MaxHeight="320"
                                                                          FontSize="11">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="2*" SortMemberPath="Item"/>
                                                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="4*" SortMemberPath="Value"/>
                                                                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="3*" SortMemberPath="Details"/>
                                                                    </DataGrid.Columns>
                                                                </DataGrid>
                                                            </Grid>
                                                        </Border>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBox Text="{Binding RawText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Visibility="{Binding HasRawText, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="AI"
                                 Tag="{x:Static viewerModels:ViewerDetailsTabKey.Ai}"
                                 Visibility="{Binding DataContext.FeaturePublication.AiAssistance, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                 DataContext="{Binding AiDetailsInvestigationViewModel}">
                            <Grid Margin="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Margin="0,0,0,6"
                                        Padding="8"
                                        Background="#FFFFFFFF"
                                        BorderBrush="#FFD8D8D8"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentTargetDisplay}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"/>
                                        <TextBlock Text="{Binding ProviderStatusDisplay}"
                                                   Margin="0,4,0,0"
                                                   Foreground="#555555"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding PrivacyWarning}"
                                                   Margin="0,4,0,0"
                                                   Foreground="#7A4D00"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="{Binding ArtifactPrompt, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="48"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             IsEnabled="{Binding HasArtifactSelected}"/>
                                    <Button Grid.Column="1"
                                            Content="Investigate"
                                            Command="{Binding RunInvestigationCommand}"
                                            Margin="6,0,0,0"
                                            Padding="10,4"
                                            VerticalAlignment="Top"/>
                                    <Button Grid.Column="2"
                                            Content="Cancel"
                                            Command="{Binding CancelInvestigationCommand}"
                                            Margin="6,0,0,0"
                                            Padding="10,4"
                                            VerticalAlignment="Top"/>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <TextBlock Margin="12"
                                               Text="Select an artifact in Details to build an AI evidence preview."
                                               Foreground="#666666"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Visibility="{Binding HasArtifactSelected, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <TextBox Text="{Binding EvidencePreview, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Visibility="{Binding HasArtifactSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>

                                <DockPanel Grid.Row="3" Margin="0,6,0,4">
                                    <ProgressBar DockPanel.Dock="Left"
                                                 Width="100"
                                                 Height="16"
                                                 IsIndeterminate="{Binding IsBusy}"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding StatusMessage}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </DockPanel>

                                <TextBox Grid.Row="4"
                                         Text="{Binding ResponseText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="11"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                    </Grid>
                </Border>
            </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2"
              Background="#FFF7F9FB"
              Visibility="{Binding IsInfrastructureWorkspaceActive, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="720"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    BorderBrush="#FFD0D0D0"
                    BorderThickness="0,0,1,0"
                    Background="#FFFAFAFA">
                <ContentControl Content="{Binding InfrastructureWorkspace}"
                                ContentTemplate="{StaticResource InfrastructureCaseExplorerTemplate}"/>
            </Border>
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="#CCCCCC"
                          Cursor="SizeWE"
                          ShowsPreview="True"/>
            <Border Grid.Column="2" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FFE8E8E8" Padding="7,4" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="Server-backed Infrastructure case" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding InfrastructureWorkspace.ActiveScopeDisplay}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding InfrastructureWorkspace.RevisionFreshnessDisplay}" Margin="0,2,0,0" Foreground="#555555"/>
                        </StackPanel>
                    </Border>
                    <ContentControl Grid.Row="1"
                                    Content="{Binding InfrastructureWorkspace}"
                                    ContentTemplate="{StaticResource InfrastructureCaseDataTemplate}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3"
                   Visibility="{Binding IsInfrastructureWorkspaceActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StatusBarItem>
                <TextBlock Text="{Binding ActiveCaptureIdentityDisplay}"
                           FontWeight="SemiBold"
                           ToolTip="Exactly one capture workspace can be active. Live mode accepts acquisition. Archived mode is capture-sealed: imports and acquisition are blocked, while annotations, index maintenance, and explicit derived enrichment of recorded evidence remain available."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding ActiveSessionFolder}"
                           ToolTip="{Binding ActiveSessionDetail}"
                           MaxWidth="620"
                           TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding LiveDatabasePath, StringFormat='Live DB: {0}'}"
                           ToolTip="{Binding LiveDatabasePath}"
                           MaxWidth="360"
                           TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding SnapshotDatabasePath, StringFormat='Viewer DB: {0}'}"
                           ToolTip="{Binding SnapshotDatabasePath}"
                           MaxWidth="360"
                           TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding SnapshotTimestampDisplay}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding SnapshotFollowStatusText}"
                           ToolTip="{Binding SnapshotFollowStatusDetail}"
                           AutomationProperties.Name="Analysis view freshness status"
                           AutomationProperties.HelpText="{Binding SnapshotFollowStatusDetail}"
                           MaxWidth="520"
                           TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem Visibility="{Binding IsSnapshotAnalysisPreparationInProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="55"
                                 Height="12"
                                 Margin="0,0,6,0"
                                 IsIndeterminate="True"/>
                    <TextBlock Text="{Binding SnapshotAnalysisPreparationText}"
                               MaxWidth="360"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Visibility="{Binding IsSnapshotAnalysisPreparationInProgress, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>

        <StatusBar Grid.Row="3"
                   Visibility="{Binding IsInfrastructureWorkspaceActive, Converter={StaticResource BoolToVisibilityConverter}}">
            <StatusBarItem>
                <TextBlock Text="{Binding InfrastructureWorkspace.ModeDisplay}" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding InfrastructureWorkspace.ActiveScopeDisplay}"
                           MaxWidth="720"
                           TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding InfrastructureWorkspace.RevisionDisplay}"
                           MaxWidth="520"
                           TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding InfrastructureWorkspace.StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Grid.Row="0"
              Grid.RowSpan="4"
              Background="#99FFFFFF"
              Visibility="{Binding IsStagingLoadInProgress, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="460"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFFFF"
                    BorderBrush="#FFB8B8B8"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding StagingLoadProgressMessage}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <ProgressBar Height="20"
                                 Minimum="0"
                                 Maximum="{Binding StagingLoadProgressTotal}"
                                 Value="{Binding StagingLoadProgressCurrent}"
                                 IsIndeterminate="{Binding IsStagingLoadProgressIndeterminate}"/>
                    <TextBlock Text="{Binding StagingLoadProgressText}"
                               Foreground="#555555"
                               HorizontalAlignment="Right"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
