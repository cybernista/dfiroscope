{
  "Profile": {
    "Id": "procinsider-etw-process-network",
    "DisplayName": "Process and Network Focused",
    "Description": "Lower-noise ETW profile focused on process lifecycle, image-load, network, DNS, and WMI activity.",
    "ExpectedVolume": "Low to Medium",
    "RiskNote": "File and registry providers are disabled to reduce event volume; use Balanced or High-Volume Diagnostic when those artifacts matter.",
    "CorrelationHints": [
      "Use process lifecycle events to anchor PID plus start-time identity.",
      "Use DNS and network events as supporting evidence for process-to-network timelines.",
      "Use WMI activity as a behavioral signal for suspicious process orchestration."
    ]
  },
  "Session": {
    "Name": "DFIRoscope-ETW",
    "BufferSizeKb": 1024,
    "MinimumBuffers": 12,
    "MaximumBuffers": 64,
    "FlushTimerSeconds": 1
  },
