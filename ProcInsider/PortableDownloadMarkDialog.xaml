<Window x:Class="ProcInsider.PortableDownloadMarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloaded DFIRoscope files"
        Width="660" Height="470" MinWidth="540" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="19" FontWeight="SemiBold"
                   Text="Remove Windows download markers?" />
        <TextBlock Grid.Row="1" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="Windows marked the listed portable DFIRoscope program files as downloaded. This can affect Viewer or Agent startup. Removing only their Zone.Identifier streams is optional. Skipping leaves every file unchanged." />
        <TextBlock Grid.Row="2" Margin="0,12,0,10" TextWrapping="Wrap"
                   Text="Before choosing Remove, verify the release source and compare its SHA-256 against an independently trusted checksum. DFIRoscope has not authenticated these files. Removal changes how Windows treats their download origin and may stop download or reputation warnings. It does not prove a file is safe, and Windows may still block it. Sessions, settings, evidence, and other alternate data streams are outside this action." />
        <TextBlock x:Name="WarningsText" Grid.Row="3" Margin="0,0,0,8"
                   Foreground="DarkOrange" TextWrapping="Wrap" Visibility="Collapsed" />
        <GroupBox Grid.Row="4" Header="Files with download markers">
            <ListBox x:Name="FilesList" Margin="6" />
        </GroupBox>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Skip" Width="110" Height="30" Margin="0,0,8,0"
                    IsCancel="True" IsDefault="True" Click="Skip_Click" />
            <Button Content="Remove markers" Width="150" Height="30"
                    Click="Remove_Click" />
        </StackPanel>
    </Grid>
</Window>
