<Window x:Class="ProcInsider.AgentShutdownConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Agent Shutdown Confirmation"
        SizeToContent="WidthAndHeight"
        MinWidth="540"
        MaxWidth="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        ContentRendered="Window_ContentRendered"
        automation:AutomationProperties.Name="Agent shutdown confirmation">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Confirm exact Agent shutdown"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="PromptText"
                       TextWrapping="Wrap"
                       MaxWidth="650"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FFF8E1"
                BorderBrush="#E0B84F"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10"
                Margin="0,14,0,16">
            <TextBlock Text="This prompt is intentionally shown above other windows. Termination still requires an explicit button click; Enter and Escape cancel safely."
                       TextWrapping="Wrap"
                       MaxWidth="630"/>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="TerminateButton"
                    Content="Terminate Agent"
                    MinWidth="126"
                    Padding="10,4"
                    Margin="0,0,8,0"
                    Click="TerminateButton_Click"
                    automation:AutomationProperties.Name="Terminate exact verified Agent"
                    automation:AutomationProperties.HelpText="Requests graceful Agent shutdown and permits only the verified process fallback described in the prompt."/>
            <Button x:Name="LeaveRunningButton"
                    Content="Leave Agent Running"
                    MinWidth="142"
                    Padding="10,4"
                    Margin="0,0,8,0"
                    Visibility="Visible"
                    Click="LeaveRunningButton_Click"
                    automation:AutomationProperties.Name="Leave Agent running and close Viewer"/>
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="84"
                    Padding="10,4"
                    IsDefault="True"
                    IsCancel="True"
                    automation:AutomationProperties.Name="Cancel Agent shutdown"/>
        </StackPanel>
    </Grid>
</Window>
