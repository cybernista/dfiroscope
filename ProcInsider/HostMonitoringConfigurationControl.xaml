<UserControl x:Class="ProcInsider.HostMonitoringConfigurationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8"
              Visibility="{Binding IsLegacyConfigurationPublished, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Row="0"
                      Grid.ColumnSpan="2"
                      Content="Install or update Sysmon"
                      IsChecked="{Binding InstallOrUpdateSysmon, Mode=TwoWay}"
                      Margin="0,0,0,6"/>
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Sysmon profile"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      ItemsSource="{Binding SysmonProfiles}"
                      SelectedItem="{Binding SelectedSysmonProfile, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      IsEnabled="{Binding HasSysmonProfiles}"
                      MinWidth="320"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8"
              Visibility="{Binding IsWindowsSecurityConfigurationPublished, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Row="2"
                      Grid.ColumnSpan="2"
                      Content="Configure audit policy"
                      IsChecked="{Binding ConfigureAuditPolicy, Mode=TwoWay}"
                      Margin="0,0,0,6"/>
            <CheckBox Grid.Row="3"
                      Grid.ColumnSpan="2"
                      Content="Enable process command-line logging"
                      IsChecked="{Binding EnableProcessCommandLineLogging, Mode=TwoWay}"
                      Margin="0,0,0,6"/>
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Audit policy profile to load"
                       VerticalAlignment="Center"
                       Margin="0,0,10,6"/>
            <ComboBox Grid.Row="0"
                      Grid.Column="1"
                      ItemsSource="{Binding SecurityMonitoringProfiles}"
                      SelectedItem="{Binding SelectedSecurityMonitoringProfile, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      IsEnabled="{Binding HasSecurityMonitoringProfiles}"
                      MinWidth="320"
                      Margin="0,0,0,6"/>
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Event log profile to load"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      ItemsSource="{Binding EventLogProfiles}"
                      SelectedItem="{Binding SelectedEventLogProfile, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      IsEnabled="{Binding HasEventLogProfiles}"
                      MinWidth="320"/>
            <CheckBox Grid.Row="4"
                      Grid.ColumnSpan="2"
                      Content="Configure Security event log channel"
                      IsChecked="{Binding ConfigureEventLogChannels, Mode=TwoWay}"
                      Margin="0,6,0,6"/>
            <CheckBox Grid.Row="5"
                      Grid.ColumnSpan="2"
                      Content="Configure Security event log retention"
                      IsChecked="{Binding ConfigureEventLogRetention, Mode=TwoWay}"/>
            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <CheckBox Content="Audit all users' Desktop, Documents and Downloads writes"
                          IsEnabled="{Binding ConfigureAuditPolicy}"
                          IsChecked="{Binding AuditUserDataFolders, Mode=TwoWay}" Margin="0,0,0,6"/>
                <CheckBox Content="Audit writes to selected persistence and security registry keys"
                          IsEnabled="{Binding ConfigureAuditPolicy}"
                          IsChecked="{Binding AuditRegistryWrites, Mode=TwoWay}" Margin="0,0,0,6"/>
                <TextBlock Text="Object auditing adds write-only SACL entries to bounded, verified objects. Check reports coverage gaps. Revert restores unchanged journaled objects; new inherited entries can require manual recovery review."
                           TextWrapping="Wrap" MaxWidth="530" HorizontalAlignment="Left"/>
                <TextBlock Text="WFP connections and removable-storage auditing can produce high Security log volume. Review Security log capacity before deployment."
                           TextWrapping="Wrap" MaxWidth="530" HorizontalAlignment="Left" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8"
              Visibility="{Binding IsLegacyConfigurationPublished, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Row="0"
                      Grid.ColumnSpan="2"
                      Content="Script block logging"
                      IsChecked="{Binding EnablePowerShellScriptBlockLogging, Mode=TwoWay}"
                      Margin="0,0,0,6"/>
            <CheckBox Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Content="Module logging"
                      IsChecked="{Binding EnablePowerShellModuleLogging, Mode=TwoWay}"
                      Margin="0,0,0,6"/>
            <CheckBox Grid.Row="2"
                      Grid.ColumnSpan="2"
                      Content="Transcription"
                      IsChecked="{Binding EnablePowerShellTranscription, Mode=TwoWay}"
                      Margin="0,0,0,6"/>
            <Grid Grid.Row="3" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="PowerShell profile"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding PowerShellAuditingProfiles}"
                          SelectedItem="{Binding SelectedPowerShellAuditingProfile, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding HasPowerShellAuditingProfiles}"
                          MinWidth="320"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="3"
              Visibility="{Binding IsLegacyConfigurationPublished, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Row="0"
                      Grid.ColumnSpan="2"
                      Content="Configure ETW profile"
                      IsChecked="{Binding ConfigureEtwSession, Mode=TwoWay}"
                      Margin="0,0,0,6"/>
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="ETW profile"
                       VerticalAlignment="Center"
                       Margin="0,0,10,6"/>
            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      ItemsSource="{Binding EtwProfiles}"
                      SelectedItem="{Binding SelectedEtwProfile, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      IsEnabled="{Binding HasEtwProfiles}"
                      MinWidth="320"
                      Margin="0,0,0,6"/>
            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Transcript folder"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Text="{Binding TranscriptDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="320"/>
        </Grid>
    </Grid>
</UserControl>
