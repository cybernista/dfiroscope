<Window x:Class="ProcInsider.AddAgentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Agent"
        SizeToContent="WidthAndHeight"
        MinWidth="680"
        MaxHeight="820"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Agent type"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <ComboBox x:Name="AgentTypeComboBox"
                              Grid.Column="1"
                              MinWidth="240"
                              SelectionChanged="AgentTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Local"
                                      Tag="Local"
                                      IsSelected="True"/>
                        <ComboBoxItem Content="Ip or hostname"
                                      Tag="Remote"
                                      IsEnabled="False"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Agent RAM"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <ComboBox x:Name="AgentMemoryComboBox"
                              Grid.Column="1"
                              MinWidth="160"
                              HorizontalAlignment="Left"
                              ToolTip="Accepted live event batches stay in RAM up to this budget, then spill to disk until SQLite catches up.">
                        <ComboBoxItem Content="500 MB"
                                      Tag="500"
                                      IsSelected="True"/>
                        <ComboBoxItem Content="1 GB"
                                      Tag="1024"/>
                        <ComboBoxItem Content="2 GB"
                                      Tag="2048"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Run duration" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <ComboBox x:Name="AgentRunDurationComboBox" IsEditable="True" MinWidth="160" HorizontalAlignment="Left"
                                  Text="Indefinitely" ToolTip="Minutes until the Agent shuts down gracefully, including idle time. It continues after the Viewer disconnects.">
                            <ComboBoxItem Content="Indefinitely"/>
                            <ComboBoxItem Content="5"/><ComboBoxItem Content="10"/><ComboBoxItem Content="15"/>
                        </ComboBox>
                        <TextBlock Text="Minutes, or Indefinitely" Foreground="#666666"/>
                        <TextBlock x:Name="RunDurationValidation" Foreground="#A00000" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="RemoteOptionsPanel"
                      Margin="0,0,0,14"
                      IsEnabled="False"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Ip or hostname"
                               VerticalAlignment="Center"
                               Margin="0,0,10,6"/>
                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             MinWidth="240"
                             Margin="0,0,0,6"
                             IsEnabled="False"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Username"
                               VerticalAlignment="Center"
                               Margin="0,0,10,6"/>
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             MinWidth="240"
                             Margin="0,0,0,6"
                             Text="DOMAIN\jsmith"
                             IsEnabled="False"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Password"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <PasswordBox Grid.Row="2"
                                 Grid.Column="1"
                                 MinWidth="240"
                                 IsEnabled="False"/>
                </Grid>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Data sources to fetch or monitor"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding CaptureOptions, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                          IsEnabled="{Binding CanConfigure}"
                                          ToolTip="{Binding Description}"
                                          Margin="0,0,14,6"/>
                                <CheckBox Content="Prefetch" Margin="20,0,14,6" IsChecked="{Binding IsIncluded, Mode=TwoWay}" IsEnabled="{Binding CanConfigure}" ToolTip="Collect execution timestamps, run count, referenced files and volume details at capture startup.">
                                    <CheckBox.Style><Style TargetType="CheckBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPrefetchChild}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></CheckBox.Style>
                                </CheckBox>
                                <CheckBox Content="Persistence" Margin="20,0,14,6"
                                          IsChecked="{Binding PersistenceOption.IsIncluded, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                          IsEnabled="{Binding PersistenceOption.CanConfigure, RelativeSource={RelativeSource AncestorType=Window}}"
                                          ToolTip="{Binding PersistenceOption.Description, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasPrefetchChild}" Value="True"/>
                                                        <Condition Binding="{Binding PersistenceOption.IsPublished, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="These choices select what the Agent collects. They do not change Windows audit policy or logging settings. To change those settings, use Monitoring configuration → Set monitoring through Agent. Missing capture prerequisites are reported separately."
                           TextWrapping="Wrap" MaxWidth="620" Margin="0,0,0,14"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="AddButton"
                    Content="Add"
                    MinWidth="76"
                    Padding="10,3"
                    Margin="0,0,6,0"
                    IsDefault="True"
                    Click="AddButton_Click"/>
            <Button Content="Cancel"
                    MinWidth="76"
                    Padding="10,3"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
