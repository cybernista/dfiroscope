<Window x:Class="ProcInsider.HostMonitoringConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProcInsider"
        Title="Host Monitoring Configuration"
        SizeToContent="WidthAndHeight"
        MinWidth="620"
        MaxHeight="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Host monitoring configuration"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <local:HostMonitoringConfigurationControl DataContext="{Binding MonitoringConfiguration, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="AcceptButton"
                    Content="{Binding PrimaryButtonContent, RelativeSource={RelativeSource AncestorType=Window}}"
                    MinWidth="86"
                    Padding="10,3"
                    Margin="0,0,6,0"
                    IsDefault="True"
                    Click="AcceptButton_Click"/>
            <Button Content="Cancel"
                    MinWidth="76"
                    Padding="10,3"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
