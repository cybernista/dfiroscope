<Window x:Class="ProcInsider.CaptureConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture Configuration"
        SizeToContent="WidthAndHeight"
        MinWidth="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Capture configuration"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding CaptureOptions, RelativeSource={RelativeSource AncestorType=Window}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}"
                              IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                              IsEnabled="{Binding CanConfigure}"
                              ToolTip="{Binding Description}"
                              Margin="0,0,14,6"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="AcceptButton"
                    Content="{Binding PrimaryButtonContent, RelativeSource={RelativeSource AncestorType=Window}}"
                    MinWidth="86"
                    Padding="10,3"
                    Margin="0,0,6,0"
                    IsDefault="True"
                    Click="AcceptButton_Click"/>
            <Button Content="Cancel"
                    MinWidth="76"
                    Padding="10,3"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
