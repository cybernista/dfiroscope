<Window x:Class="ProcInsider.Features.NativeEventProfiles.NativeEventProfileEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Native event profiles" Width="1120" Height="760" MinWidth="820" MinHeight="560"
 WindowStartupLocation="CenterOwner" Closing="OnClosing">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Native event profiles" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock Text="High, Medium and Low describe investigative usefulness, not severity. Labels do not change native identities. Unclassified fields remain available as Medium." TextWrapping="Wrap" Margin="0,6"/>
   <TextBlock Text="{Binding Coverage}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding SampleDescription}" TextWrapping="Wrap" Margin="0,6"/>
  </StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.AutomationId="NativeProfileStatus"/>
  <Grid IsEnabled="{Binding CanEdit}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel>
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
     <Button Content="Import previous file..." Click="OnImportPreviousFile" Padding="8,4" Margin="2"/>
     <Button Content="New" Command="{Binding NewCommand}" Padding="8,4" Margin="2"/>
     <Button Content="Duplicate selected" Command="{Binding DuplicateCommand}" Padding="8,4" Margin="2"/>
     <Button Content="Migrate previous fields" Command="{Binding ImportLegacyFieldsCommand}" Padding="8,4" Margin="2"/>
    </WrapPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SavedOrigin}" TextWrapping="Wrap" Margin="0,6"/>
    <ListBox x:Name="ProfilesList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=OneWay}" SelectionChanged="OnProfileSelectionChanged"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="NativeProfilesList">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,4">
      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding EventType.Provider}" TextWrapping="Wrap"/>
      <TextBlock TextWrapping="Wrap"><Run Text="{Binding EventType.Channel}"/><Run Text=" / "/><Run Text="{Binding EventType.EventId}"/><Run Text=" v"/><Run Text="{Binding EventType.Version}"/></TextBlock>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <DockPanel Grid.Column="2">
    <StackPanel DockPanel.Dock="Top">
     <Border x:Name="PendingSwitchPanel" BorderBrush="DarkOrange" BorderThickness="1" Padding="6" Margin="0,0,0,6">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPendingProfile}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <StackPanel><TextBlock Text="{Binding PendingMessage}" TextWrapping="Wrap"/>
       <WrapPanel>
        <Button x:Name="SaveAndSwitchButton" Content="Save and switch" Command="{Binding SaveAndSwitchCommand}" Padding="8,4" Margin="2"/>
        <Button x:Name="DiscardAndSwitchButton" Content="Discard and switch" Command="{Binding DiscardAndSwitchCommand}" Padding="8,4" Margin="2"/>
        <Button x:Name="KeepEditingButton" Content="Keep editing" Command="{Binding KeepEditingCommand}" Padding="8,4" Margin="2"/>
       </WrapPanel>
      </StackPanel>
     </Border>
     <TextBlock Text="Draft name"/>
     <TextBox x:Name="ProfileNameBox" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" Margin="0,2,0,6"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,6,0"><TextBlock Text="Exact provider"/><TextBox Text="{Binding Provider, UpdateSourceTrigger=PropertyChanged}" MaxLength="512"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,6,0"><TextBlock Text="Exact channel"/><TextBox Text="{Binding Channel, UpdateSourceTrigger=PropertyChanged}" MaxLength="512"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,6,0"><TextBlock Text="Event ID"/><TextBox Text="{Binding EventId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Grid.Column="3"><TextBlock Text="Version"/><TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     </Grid>
     <WrapPanel Margin="0,6">
      <Button Content="Add observed fields" Command="{Binding AddObservedCommand}" Padding="8,4" Margin="2"/>
      <Button Content="Remove field" Command="{Binding RemoveFieldCommand}" Padding="8,4" Margin="2"/>
      <Button Content="Move up" Command="{Binding MoveUpCommand}" Padding="8,4" Margin="2"/>
      <Button Content="Move down" Command="{Binding MoveDownCommand}" Padding="8,4" Margin="2"/>
     </WrapPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Expander Header="Preserved legacy definition"><TextBox Text="{Binding LegacyDefinition, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto"/></Expander>
     <TextBlock Text="Exact path including occurrence (for example EventData/CommandLine[1])" TextWrapping="Wrap" Margin="0,6,0,2"/>
     <DockPanel><Button DockPanel.Dock="Right" Content="Add path" Command="{Binding AddFieldCommand}" Padding="8,4" Margin="6,0,0,0"/><TextBox Text="{Binding NewPath, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048"/></DockPanel>
     <WrapPanel Margin="0,8,0,0">
      <Button x:Name="SaveProfileButton" Content="Save profile" Command="{Binding SaveCommand}" Padding="12,5" Margin="2" AutomationProperties.AutomationId="SaveNativeProfile"/>
      <Button Content="Discard draft / reload" Command="{Binding DiscardAndReloadCommand}" Padding="12,5" Margin="2"/>
      <TextBlock Text="Unsaved changes" Margin="10,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDirty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </WrapPanel>
    </StackPanel>
    <DataGrid x:Name="ProfileFieldsGrid" ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}" AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" EnableRowVirtualization="True" SelectionMode="Single">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Order" Binding="{Binding Order}" IsReadOnly="True" Width="48"/>
      <DataGridTextColumn Header="Native path" Binding="{Binding Path}" IsReadOnly="True" Width="220"/>
      <DataGridTemplateColumn Header="Label" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Priority" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Priorities, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Classification" Binding="{Binding Classification}" IsReadOnly="True" Width="180"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
