<Window x:Class="ProcInsider.Features.InvestigationWorkspaces.NativeEventPresetEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Events field presets" Width="1150" Height="760" MinWidth="850" MinHeight="580" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="12">
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8"/>
  <StackPanel DockPanel.Dock="Top" IsEnabled="{Binding CanEdit}">
   <TextBlock Text="Presets change columns, not which events match. Closing retains this workspace's draft." TextWrapping="Wrap"/>
   <WrapPanel Margin="0,8">
    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Width="250"/>
    <Button Content="New from layout" Command="{Binding NewCommand}" Margin="4,0"/>
    <Button Content="Edit" Command="{Binding EditCommand}" Margin="4,0"/>
    <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Margin="4,0"/>
    <Button Content="Discard draft / reload" Command="{Binding DiscardAndReloadCommand}" Margin="4,0"/>
    <Button x:Name="ApplyPresetButton" Content="Apply saved preset" Command="{Binding ApplyCommand}" Margin="4,0"/>
   </WrapPanel>
   <WrapPanel><TextBlock Text="Name" VerticalAlignment="Center"/><TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" Width="350" Margin="8,0"/>
    <Button x:Name="SavePresetButton" Content="Save preset" Command="{Binding SaveCommand}"/>
    <TextBlock Text="{Binding ColumnCount, StringFormat='{}{0} columns'}" VerticalAlignment="Center" Margin="12,0"/>
   </WrapPanel>
   <WrapPanel Margin="0,8">
    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Width="300"/>
    <CheckBox Content="High" IsChecked="{Binding High}" Margin="8,0" VerticalAlignment="Center"/>
    <CheckBox Content="Medium" IsChecked="{Binding Medium}" Margin="8,0" VerticalAlignment="Center"/>
    <CheckBox Content="Low" IsChecked="{Binding Low}" Margin="8,0" VerticalAlignment="Center"/>
    <Button Content="Compose categories / update revisions" Command="{Binding AddProfileCommand}"/>
    <Button Content="Update profile revisions" Command="{Binding UpdateProfilesCommand}" Margin="6,0"/>
   </WrapPanel>
   <TextBlock Text="{Binding ProfileRevisions}" TextWrapping="Wrap" MaxHeight="55" ToolTip="{Binding ProfileRevisions}"/>
   <WrapPanel Margin="0,8">
    <ComboBox ItemsSource="{Binding OrdinaryColumns}" SelectedItem="{Binding SelectedOrdinaryColumn}" Width="180"/>
    <Button Content="Add ordinary column" Command="{Binding AddOrdinaryCommand}" Margin="6,0"/>
    <ComboBox ItemsSource="{Binding ManualPaths}" Text="{Binding ManualPath, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Width="350"/>
    <Button Content="Add manual extracted path" Command="{Binding AddManualCommand}" Margin="6,0"/>
   </WrapPanel>
   <WrapPanel>
    <CheckBox Content="Apply automatically for explicit filter:" IsChecked="{Binding Associate}" VerticalAlignment="Center"/>
    <TextBlock Text="Provider" Margin="8,0" VerticalAlignment="Center"/><TextBox Text="{Binding AssociationProvider, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
    <TextBlock Text="Channel" Margin="8,0" VerticalAlignment="Center"/><TextBox Text="{Binding AssociationChannel, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
    <TextBlock Text="Event ID" Margin="8,0" VerticalAlignment="Center"/><TextBox Text="{Binding AssociationEventId, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
   </WrapPanel>
   <TextBlock Text="Blank provider/channel matches an unset filter. Native version stays part of each column identity. Conflicting associations leave the layout unchanged." TextWrapping="Wrap" Margin="0,4"/>
   <WrapPanel Margin="0,4"><Button Content="Move up" Command="{Binding MoveUpCommand}"/><Button Content="Move down" Command="{Binding MoveDownCommand}" Margin="6,0"/><Button Content="Remove column" Command="{Binding RemoveColumnCommand}"/></WrapPanel>
  </StackPanel>
  <DataGrid x:Name="PresetColumnsGrid" ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}" IsEnabled="{Binding CanEdit}"
    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" EnableRowVirtualization="True">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Exact identity" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
    <DataGridTextColumn Header="Label" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
    <DataGridTextColumn Header="Width (pixels)" Binding="{Binding Width, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="110"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
