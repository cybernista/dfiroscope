<UserControl x:Class="ProcInsider.Features.InvestigationWorkspaces.EventsWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:root="clr-namespace:ProcInsider"
 xmlns:presentation="clr-namespace:ProcInsider.Views.Presentation"
 xmlns:events="clr-namespace:ProcInsider.Features.InvestigationWorkspaces"
 xmlns:shared="clr-namespace:ProcInsider.Views.Shared">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Views/Shared/ColumnHeaderResources.xaml"/></ResourceDictionary.MergedDictionaries><root:FeaturePublicationBindingProxy x:Key="FeaturePublicationProxy" Data="{Binding FeaturePublication}"/><BooleanToVisibilityConverter x:Key="SecurityFacetVisibility"/> <DataTemplate x:Key="ContextFieldTemplate">
  <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="3" Margin="0,2">
   <StackPanel>
    <DockPanel><CheckBox DockPanel.Dock="Right" Content="Pin" IsChecked="{Binding IsPinned, Mode=TwoWay}"/><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
    <TextBlock Text="{Binding Path}" Foreground="#666" TextWrapping="Wrap" FontSize="10"/>
    <TextBox Text="{Binding DisplayValue, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
   </StackPanel>
  </Border>
 </DataTemplate>
 <BooleanToVisibilityConverter x:Key="HighlightVisibility"/>
 <Style x:Key="WorkspaceToolbar" TargetType="Border">
  <Setter Property="Background" Value="#F5F7FA"/><Setter Property="BorderBrush" Value="#D8DEE8"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/>
  <Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,0,0,5"/>
 </Style>
 <Style x:Key="WorkspaceAction" TargetType="Button">
  <Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="2"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
 </Style>
 <Style x:Key="ListingValue" TargetType="TextBlock">
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Style.Triggers><DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="&lt;not applicable&gt;">
   <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
  </DataTrigger></Style.Triggers>
 </Style>
 <DataTemplate x:Key="ExtractedColumnHeaderTemplate">
  <shared:ColumnHeaderFilterControl Title="{Binding Label}" Filter="{Binding Filter}"/>
 </DataTemplate>
 <DataTemplate x:Key="ExpandedFieldsTemplate">
  <StackPanel x:Name="RowHighlights">
   <TextBlock Text="{Binding ProfileStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProfileStatus}" Margin="0,2"/>
   <DataGrid x:Name="ExpandedFieldsGrid" ItemsSource="{Binding ExpandedFields}" AutoGenerateColumns="False" IsReadOnly="True"
      CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="Column" MaxHeight="240"
      EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
      VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" RowHeight="24">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="75"/>
     <DataGridTextColumn Header="Name" Binding="{Binding Label}" Width="200">
      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGridTextColumn.ElementStyle>
     </DataGridTextColumn>
     <DataGridTemplateColumn Header="Value" Width="*" MinWidth="120"><DataGridTemplateColumn.CellTemplate><DataTemplate>
      <TextBox Text="{Binding DisplayValue, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" BorderThickness="0" Padding="1,0"
          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" ToolTip="{Binding DisplayValue}"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
  </StackPanel>
 </DataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <Grid x:Name="LayoutGrid" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
  <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="6"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
  <DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="5">
    <Border Style="{StaticResource WorkspaceToolbar}">
    <WrapPanel x:Name="FieldsBar">
     <shared:ListingColumnPicker Grid="{Binding ElementName=EventsGrid}" Settings="{Binding ListingColumns}" Margin="2"/>
     <ToggleButton x:Name="ExtractedFieldsButton" Content="Fields Extracted" Padding="10,4" Margin="2"
                   AutomationProperties.AutomationId="ExtractedEventFieldsPicker" ToolTip="Choose native fields as display columns. Use Field statistics for discovery and exact counts across all pages."/>
     <Popup x:Name="ExtractedFieldsPopup" PlacementTarget="{Binding ElementName=ExtractedFieldsButton}" Placement="Bottom" StaysOpen="False"
            IsOpen="{Binding IsChecked, ElementName=ExtractedFieldsButton, Mode=TwoWay}">
      <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="Gray" BorderThickness="1" Padding="10" Width="760">
       <DockPanel MaxHeight="440">
        <TextBlock DockPanel.Dock="Top" Text="Use the Field statistics tab to discover native fields across the selected dataset. Completed results extend this chooser." TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ExtractedFieldsStatus}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <DataGrid x:Name="ExtractedFieldsGrid" DataContext="{Binding FieldChooser}" ItemsSource="{Binding Fields}" AutoGenerateColumns="False" IsReadOnly="True"
          CanUserAddRows="False" ColumnHeaderStyle="{StaticResource ColumnFilterHeaderStyle}" HeadersVisibility="Column"
          EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
         <DataGrid.Columns>
          <DataGridTemplateColumn Header="✓" Width="28" CanUserSort="False">
           <DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader"/></DataGridTemplateColumn.HeaderStyle>
           <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Show field column"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" SortMemberPath="Profile" Width="280"/>
          <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" SortMemberPath="Priority" Width="95"/>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="*" MinWidth="200">
           <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Identity.Description}"/></Style></DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
         </DataGrid.Columns>
        </DataGrid>
       </DockPanel>
      </Border>
     </Popup>
     <Button x:Name="ProfilesButton" Content="Event Profiles" Style="{StaticResource WorkspaceAction}" AutomationProperties.AutomationId="NativeEventProfilesEditor"/>
     <Button x:Name="PresetsButton" Content="Fields Presets" Style="{StaticResource WorkspaceAction}" AutomationProperties.AutomationId="NativeEventPresetsEditor"/>
    </WrapPanel>
    </Border>
    <Border Style="{StaticResource WorkspaceToolbar}">
    <DockPanel x:Name="ListingActionBar">
     <ProgressBar x:Name="ListingProgress" DockPanel.Dock="Right" Width="80" Height="5" Margin="12,0,4,0" VerticalAlignment="Center"
      IsIndeterminate="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource HighlightVisibility}}"
      ToolTip="Loading events and preparing fields…" AutomationProperties.Name="Loading events"/>
    <WrapPanel VerticalAlignment="Center">
     <Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}" Style="{StaticResource WorkspaceAction}"/>
     <CheckBox Content="Keep current layout" IsChecked="{Binding KeepCurrentLayout, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,2"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,2">
     <TextBlock Text="Expanded fields:" Margin="0,0,8,0" VerticalAlignment="Center"/>
     <CheckBox x:Name="HighHighlights" Content="High" IsChecked="{Binding ShowHighHighlights, Mode=TwoWay}" Margin="0,0,12,0"/>
     <CheckBox x:Name="MediumHighlights" Content="Medium" IsChecked="{Binding ShowMediumHighlights, Mode=TwoWay}" Margin="0,0,12,0"/>
     <CheckBox x:Name="LowHighlights" Content="Low" IsChecked="{Binding ShowLowHighlights, Mode=TwoWay}"/>
    </StackPanel>
     <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource WorkspaceAction}"/>
     <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource WorkspaceAction}"/>
    </WrapPanel>
    </DockPanel>
    </Border>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="5">
    <WrapPanel><Button Content="Previous" Command="{Binding PreviousPageCommand}"/><TextBlock Text="{Binding PageDisplay}" Margin="10,0" VerticalAlignment="Center"/><Button Content="Next" Command="{Binding NextPageCommand}"/></WrapPanel>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4"/>
    <TextBlock x:Name="PresetStatusText" Text="{Binding PresetStatus}" TextWrapping="Wrap"/>
   </StackPanel>
   <DataGrid x:Name="EventsGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" CanUserSortColumns="True" Sorting="SortEvents" ColumnHeaderStyle="{StaticResource ColumnFilterHeaderStyle}" AreRowDetailsFrozen="True"
    EnableRowVirtualization="True" EnableColumnVirtualization="True" FrozenColumnCount="1" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
    AutomationProperties.AutomationId="EventsWorkspaceListing">
    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="DetailsVisibility" Value="Collapsed"/>
     <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
     <Setter Property="ContextMenu"><Setter.Value>
      <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
       <MenuItem Header="Add event to comparison" Command="{Binding Tag.AddComparisonCommand}" CommandParameter="{Binding DataContext}"/>
      </ContextMenu>
     </Setter.Value></Setter>
     <Style.Triggers><DataTrigger Binding="{Binding HighlightsExpanded}" Value="True"><Setter Property="DetailsVisibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
<DataGrid.RowDetailsTemplate><DataTemplate>
 <Border HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}" Padding="8,2,24,2">
 <ContentControl Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl">
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate/></Setter.Value></Setter>
  <Style.Triggers><DataTrigger Binding="{Binding HighlightsExpanded}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ExpandedFieldsTemplate}"/></DataTrigger></Style.Triggers>
 </Style></ContentControl.Style></ContentControl>
 </Border>
</DataTemplate></DataGrid.RowDetailsTemplate>
<DataGrid.Columns>
     <DataGridTemplateColumn x:Name="HighlightsColumn" Header="" Width="28" MinWidth="28" MaxWidth="28" CanUserSort="False" CanUserReorder="False" CanUserResize="False">
      <DataGridTemplateColumn.HeaderStyle><Style TargetType="DataGridColumnHeader"/></DataGridTemplateColumn.HeaderStyle>
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <ToggleButton IsChecked="{Binding HighlightsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Expand or collapse native fields" AutomationProperties.Name="Expand native fields" Padding="0" Width="22" Height="18" Background="Transparent" BorderThickness="0">
        <ToggleButton.Style><Style TargetType="ToggleButton"><Setter Property="Content" Value="▸"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="▾"/></Trigger></Style.Triggers></Style></ToggleButton.Style>
       </ToggleButton>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTextColumn Header="Time" SortMemberPath="Timestamp" Binding="{Binding TimeDisplay}" Width="150"/>
     <DataGridTextColumn Header="Event ID" SortMemberPath="EventId" Binding="{Binding EventCodeDisplay}" Width="75"/>
     <DataGridTextColumn Header="Description" SortMemberPath="Description" Binding="{Binding Description}" Width="190"/>
     <DataGridTextColumn Header="Actor" SortMemberPath="Actor" Binding="{Binding Actor}" Width="180" Visibility="{Binding Data.WindowsSecurityEvents, Source={StaticResource FeaturePublicationProxy}, Converter={StaticResource SecurityFacetVisibility}}"/>
     <DataGridTextColumn Header="Target identity" SortMemberPath="TargetIdentity" Binding="{Binding TargetIdentity}" Width="180" Visibility="{Binding Data.WindowsSecurityEvents, Source={StaticResource FeaturePublicationProxy}, Converter={StaticResource SecurityFacetVisibility}}"/>
     <DataGridTextColumn Header="Details" SortMemberPath="Details" Binding="{Binding DetailsSummary}" Width="320"/>
     <DataGridTextColumn Header="Provider" SortMemberPath="Provider" Binding="{Binding Provider}" Width="240"/>
     <DataGridTextColumn Header="Channel" SortMemberPath="Channel" Binding="{Binding Channel}" Width="100"/>
     <DataGridTextColumn Header="Host" SortMemberPath="Host" Binding="{Binding Host}" Width="160"/>
     <DataGridTextColumn Header="Process correlation" SortMemberPath="Correlation" Binding="{Binding Correlation}" Width="160"/>
    </DataGrid.Columns>
   </DataGrid>
  </DockPanel>
  <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"/>
  <Grid Grid.Row="2" x:Name="SupportingGrid">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <TabControl SelectedIndex="{Binding SelectedDataTabIndex, Mode=TwoWay}">
    <TabItem Header="Event"><TextBox Text="{Binding InspectorPaneViewModel.RawText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
    <TabItem Header="Fields"><DataGrid x:Name="EventFieldsGrid" ItemsSource="{Binding InspectorPaneViewModel.Properties}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="130"/>
      <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="280"/>
      <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
     </DataGrid.Columns>
    </DataGrid></TabItem>
    <TabItem Header="Compare"><events:EventsComparisonView/></TabItem>
    <TabItem Header="Field statistics">
     <Grid Margin="6">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel>
       <ComboBox x:Name="StatisticsScopePicker" SelectedIndex="{Binding StatisticsScopeIndex, Mode=TwoWay}" MinWidth="240" Margin="2">
        <ComboBoxItem Content="Current filtered dataset (all pages)"/>
        <ComboBoxItem Content="Entire capture (published event sources)"/>
       </ComboBox>
       <Button x:Name="CalculateFieldStatistics" Content="Calculate exact statistics" Command="{Binding CalculateStatisticsCommand}" Margin="2"/>
       <Button Content="Cancel statistics" Command="{Binding CancelStatisticsCommand}" Margin="2"/>
       <Button Content="Add selected field as column" Command="{Binding AddStatisticsColumnCommand}" Margin="2"/>
      </WrapPanel>
      <TextBlock Grid.Row="1" Text="{Binding StatisticsStatus}" TextWrapping="Wrap" Margin="2,5"/>
      <DataGrid Grid.Row="2" x:Name="FieldStatisticsGrid" ItemsSource="{Binding StatisticsFields}" SelectedItem="{Binding SelectedStatisticsField, Mode=TwoWay}"
       IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Qualified native field / occurrence" Binding="{Binding Identity}" Width="*"/>
        <DataGridTextColumn Header="Events present" Binding="{Binding PresentEvents}" Width="100"/>
        <DataGridTextColumn Header="Unique values" Binding="{Binding UniqueValues}" Width="100"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="3" Text="Selected field — ten most common exact values (event counts)" FontWeight="SemiBold" Margin="2,5"/>
      <DataGrid Grid.Row="4" x:Name="FieldStatisticsValues" ItemsSource="{Binding StatisticsTopValues}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Original extracted value" Binding="{Binding Value}" Width="*"/>
        <DataGridTextColumn Header="Length (0 = empty)" Binding="{Binding Value.Length}" Width="120"/>
        <DataGridTextColumn Header="Events" Binding="{Binding EventCount}" Width="85"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </TabItem>
   </TabControl>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
   <Grid Grid.Column="2">
 <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <DockPanel>
  <StackPanel DockPanel.Dock="Top" Margin="5">
   <TextBlock Text="Native field inspector" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding ContextualStatus}" TextWrapping="Wrap" FontSize="11"/>
   <DockPanel Margin="0,4"><Button x:Name="UseDetailsProfileButton" DockPanel.Dock="Right" Content="Use for Details" Margin="4,0"/><ComboBox x:Name="DetailsProfilePicker" ItemsSource="{Binding MatchingDetailsProfiles}" SelectedItem="{Binding DetailsProfileChoice, Mode=TwoWay}" DisplayMemberPath="Name" ToolTip="Choose one profile for this exact schema in this workspace."/></DockPanel>
   <TextBlock Text="Search field name, native path or value"/><TextBox x:Name="NativeFieldSearch" Text="{Binding FieldSearch, UpdateSourceTrigger=PropertyChanged}"/>
   <TextBlock Text="{Binding FieldSearchStatus}" FontSize="11"/>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="5">
    <Expander Header="High — investigative highlights" IsExpanded="True"><ItemsControl x:Name="HighFieldItems" ItemsSource="{Binding HighFields}" ItemTemplate="{StaticResource ContextFieldTemplate}"/></Expander>
    <Expander Header="Pinned fields" IsExpanded="True"><ItemsControl x:Name="PinnedFieldItems" ItemsSource="{Binding PinnedFields}" ItemTemplate="{StaticResource ContextFieldTemplate}"/></Expander>
    <Expander Header="Medium — includes unclassified fields" IsExpanded="{Binding MediumExpanded, Mode=TwoWay}"><ItemsControl ItemsSource="{Binding MediumFields}" ItemTemplate="{StaticResource ContextFieldTemplate}"/></Expander>
    <Expander Header="Low" IsExpanded="{Binding LowExpanded, Mode=TwoWay}"><ItemsControl ItemsSource="{Binding LowFields}" ItemTemplate="{StaticResource ContextFieldTemplate}"/></Expander>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
 <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"/>
 <presentation:DetailsPresentationView Grid.Row="2"/>
</Grid>
  </Grid>
 </Grid>
</UserControl>
