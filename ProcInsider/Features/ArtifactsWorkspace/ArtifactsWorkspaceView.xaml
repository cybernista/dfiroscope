<UserControl x:Class="ProcInsider.Features.InvestigationWorkspaces.ArtifactsWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shared="clr-namespace:ProcInsider.Views.Shared">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Views/Shared/ColumnHeaderResources.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible"/></ResourceDictionary></UserControl.Resources>
 <Grid Background="White"><Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="6"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
  <DockPanel Margin="5"><StackPanel DockPanel.Dock="Top"><WrapPanel><Button Content="Refresh view" Command="{Binding RefreshCommand}" ToolTip="Reads the assessed snapshot only; it does not collect Prefetch files."/><Button Content="Cancel read" Command="{Binding CancelCommand}"/><Button Content="Clear Listing filters" Command="{Binding ClearFiltersCommand}"/><Button Content="Collect Prefetch" Command="{Binding CollectPrefetchCommand}" ToolTip="Requests the connected Agent to examine its fixed local Prefetch root; original PF files are not retained."/><Button Content="Cancel collection" Command="{Binding CancelCollectionCommand}"/></WrapPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4" AutomationProperties.AutomationId="ArtifactsStatus"/><TextBlock Text="{Binding ActionStatus}" TextWrapping="Wrap"/></StackPanel>
   <WrapPanel DockPanel.Dock="Bottom"><Button Content="Previous" Command="{Binding PreviousCommand}"/><Button Content="Next" Command="{Binding NextCommand}"/><TextBlock Text="{Binding MatchingRows,StringFormat={}{0:N0} matching retained results}" Margin="6,0" VerticalAlignment="Center"/></WrapPanel>
   <DataGrid x:Name="ListingGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow,Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" Sorting="SortListing" ColumnHeaderStyle="{StaticResource ColumnFilterHeaderStyle}" shared:ColumnFilterLookupConverter.Filters="{Binding HeaderFilters}" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.AutomationId="ArtifactsListing" CanUserResizeColumns="True">
    <DataGrid.Columns><DataGridTextColumn Header="Time" SortMemberPath="ObservedUtc" Binding="{Binding PrimaryTimeUtc,StringFormat=yyyy-MM-dd HH:mm:ss.fff}" Width="180"/><DataGridTextColumn Header="Artifact Type" SortMemberPath="ArtifactType" Binding="{Binding ArtifactType}" Width="125"/><DataGridTextColumn Header="Category" SortMemberPath="Category" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="Name" SortMemberPath="Name" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="Summary" SortMemberPath="Summary" Binding="{Binding Summary}" Width="260"/><DataGridTextColumn Header="Source" SortMemberPath="SourcePath" Binding="{Binding SourcePath}" Width="260"/><DataGridTextColumn Header="Host" SortMemberPath="Host" Binding="{Binding Scope.HostId}" Width="150"/></DataGrid.Columns>
   </DataGrid>
  </DockPanel><GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"/>
  <TabControl Grid.Row="2" Margin="5" SelectedIndex="{Binding DataTabIndex,Mode=TwoWay}">
   <TabItem Header="Summary" Visibility="{Binding HasPrefetchPresentation,Converter={StaticResource Visible}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
     <TextBlock Text="Prefetch investigation" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
     <ItemsControl ItemsSource="{Binding Prefetch.Data.Summary}" AutomationProperties.AutomationId="PrefetchSummary"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="{Binding Prefetch.Data.Qualification}" TextWrapping="Wrap" Margin="0,10,0,6"/>
     <TextBlock Text="{Binding Prefetch.InterpretationText}" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Execution history" Visibility="{Binding HasPrefetchPresentation,Converter={StaticResource Visible}}">
    <DockPanel Margin="6"><TextBlock DockPanel.Dock="Top" Text="Recent execution timestamps recorded inside this Prefetch file. Empty timestamp slots are omitted; this is not a complete execution log." TextWrapping="Wrap" Margin="0,0,0,6"/>
     <DataGrid x:Name="PrefetchRunsGrid" ItemsSource="{Binding Prefetch.Data.Runs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" CanUserResizeColumns="True"><DataGrid.Columns><DataGridTextColumn Header="Recorded execution time (UTC)" Binding="{Binding RecordedUtc}" SortMemberPath="RecordedUtc" Width="*"/></DataGrid.Columns></DataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="Referenced files" Visibility="{Binding HasPrefetchPresentation,Converter={StaticResource Visible}}">
    <DockPanel Margin="6"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Files referenced during startup. A reference does not prove separate execution or establish how the file was used." TextWrapping="Wrap" Margin="0,0,0,5"/><DockPanel Margin="0,0,0,6"><TextBlock Text="Find path:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding Prefetch.FileSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="PrefetchFileSearch"/></DockPanel></StackPanel>
     <DataGrid x:Name="PrefetchFilesGrid" ItemsSource="{Binding Prefetch.FilesView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserSortColumns="True" CanUserResizeColumns="True"><DataGrid.Columns><DataGridTextColumn Header="Filename" Binding="{Binding Name}" SortMemberPath="Name" Width="220"/><DataGridTextColumn Header="Extension" Binding="{Binding Extension}" SortMemberPath="Extension" Width="85"/><DataGridTextColumn Header="Recorded path" Binding="{Binding RecordedPath}" SortMemberPath="RecordedPath" Width="*"/><DataGridTextColumn Header="Path state" Binding="{Binding PathState}" SortMemberPath="PathState" Width="100"/></DataGrid.Columns></DataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="Volumes and folders" Visibility="{Binding HasPrefetchPresentation,Converter={StaticResource Visible}}">
    <Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
     <TextBlock Text="Recorded volumes. Volume creation time is not a program execution time; volume paths are not mapped to drive letters." TextWrapping="Wrap" Margin="0,0,0,5"/>
     <DataGrid Grid.Row="1" x:Name="PrefetchVolumesGrid" ItemsSource="{Binding Prefetch.Data.Volumes}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" CanUserResizeColumns="True"><DataGrid.Columns><DataGridTextColumn Header="Volume #" Binding="{Binding Volume}" SortMemberPath="Volume" Width="85"/><DataGridTextColumn Header="Recorded volume path" Binding="{Binding RecordedPath}" SortMemberPath="RecordedPath" Width="*"/><DataGridTextColumn Header="Serial number (hex)" Binding="{Binding SerialNumber}" SortMemberPath="SerialNumber" Width="150"/><DataGridTextColumn Header="Volume created (UTC)" Binding="{Binding CreatedUtc}" SortMemberPath="CreatedUtc" Width="285"/><DataGridTextColumn Header="Declared folders" Binding="{Binding RecordedDirectoryCount}" SortMemberPath="RecordedDirectoryCount" Width="120"/></DataGrid.Columns></DataGrid>
     <DockPanel Grid.Row="2" Margin="0,6"><TextBlock Text="Find folder:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding Prefetch.FolderSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="PrefetchFolderSearch"/></DockPanel>
     <DataGrid Grid.Row="3" x:Name="PrefetchFoldersGrid" ItemsSource="{Binding Prefetch.FoldersView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" CanUserSortColumns="True" CanUserResizeColumns="True"><DataGrid.Columns><DataGridTextColumn Header="Volume #" Binding="{Binding Volume}" SortMemberPath="Volume" Width="85"/><DataGridTextColumn Header="Recorded folder path" Binding="{Binding RecordedPath}" SortMemberPath="RecordedPath" Width="*"/><DataGridTextColumn Header="Path state" Binding="{Binding PathState}" SortMemberPath="PathState" Width="100"/></DataGrid.Columns></DataGrid>
    </Grid>
   </TabItem><TabItem Header="Technical details"><DockPanel><Button DockPanel.Dock="Top" Content="Clear property filters" Command="{Binding ClearPropertiesCommand}" HorizontalAlignment="Left"/><DataGrid x:Name="PropertiesGrid" ItemsSource="{Binding PropertiesView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" Sorting="SortProperties" ColumnHeaderStyle="{StaticResource ColumnFilterHeaderStyle}" shared:ColumnFilterLookupConverter.Filters="{Binding PropertyFilters}" AutomationProperties.AutomationId="ArtifactsNativeProperties" CanUserResizeColumns="True"><DataGrid.Columns><DataGridTextColumn Header="Group" SortMemberPath="Group" Binding="{Binding Group}" Width="150"/><DataGridTextColumn Header="Property" SortMemberPath="Name" Binding="{Binding Name}" Width="240"/><DataGridTextColumn Header="Recorded value" SortMemberPath="Value" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem><TabItem Header="Source-read lineage"><DockPanel><Button DockPanel.Dock="Top" Content="Clear lineage filters" Command="{Binding ClearReadOccurrencesCommand}" HorizontalAlignment="Left"/><DataGrid x:Name="ReadOccurrencesGrid" ItemsSource="{Binding ReadOccurrencesView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" Sorting="SortReadOccurrences" ColumnHeaderStyle="{StaticResource ColumnFilterHeaderStyle}" shared:ColumnFilterLookupConverter.Filters="{Binding ReadOccurrenceFilters}" AutomationProperties.AutomationId="ArtifactsReadOccurrences" CanUserResizeColumns="True"><DataGrid.Columns><DataGridTextColumn Header="Group" SortMemberPath="Group" Binding="{Binding Group}" Width="160"/><DataGridTextColumn Header="Observed UTC" SortMemberPath="Name" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="Immutable receipt provenance" SortMemberPath="Value" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem></TabControl>
 </Grid>
</UserControl>
