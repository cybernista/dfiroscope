<UserControl x:Class="ProcInsider.Features.InvestigationWorkspaces.NetworkWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shared="clr-namespace:ProcInsider.Views.Shared" xmlns:selectedProcess="clr-namespace:ProcInsider.Views.Features.SelectedProcess"
 xmlns:ai="clr-namespace:ProcInsider.Views.Features.Ai">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Views/Shared/ColumnHeaderResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid x:Name="LayoutGrid" Background="White">
  <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="6"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
  <DockPanel Margin="5">
   <StackPanel DockPanel.Dock="Top">
    <WrapPanel Margin="0,0,0,5">
     <shared:ListingColumnPicker Grid="{Binding ElementName=NetworkGrid}" Settings="{Binding ListingColumns}">
      <shared:ListingColumnPicker.Style><Style TargetType="shared:ListingColumnPicker"><Style.Triggers><DataTrigger Binding="{Binding IsEndpointScope}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></shared:ListingColumnPicker.Style>
     </shared:ListingColumnPicker>
     <TextBox Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" Width="180" ToolTip="Filter recorded endpoint fields or observations"/>
     <Button Content="Clear Listing filters" Command="{Binding ClearFiltersCommand}" ToolTip="Clear text and column filters for this listing; retain Explorer scope selections."/>
     <Button Content="Apply filter" Command="{Binding ApplyCommand}"/>
     <Button Content="Refresh observations" Command="{Binding RefreshCommand}" Padding="6,2" Margin="5,0"/>
    </WrapPanel>
    <TextBlock Text="{Binding NavigationDescription}" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,3" AutomationProperties.AutomationId="NetworkWorkspaceStatus"/>
   </StackPanel>
   <WrapPanel DockPanel.Dock="Bottom" Margin="0,5">
    <Button Content="Previous" Command="{Binding PreviousCommand}"/><Button Content="Next" Command="{Binding NextCommand}" Margin="5,0"/>
    <TextBlock Text="{Binding MatchingRecords, StringFormat={}{0:N0} recorded observations}" VerticalAlignment="Center"/>
   </WrapPanel>
   <Grid>
   <DataGrid x:Name="EndpointGrid" ItemsSource="{Binding EndpointRows}" SelectedItem="{Binding SelectedEndpoint,Mode=TwoWay}" AutoGenerateColumns="False"
    CanUserAddRows="False" IsReadOnly="True" Sorting="SortEndpoint" CanUserSortColumns="True" ColumnHeaderStyle="{StaticResource ColumnFilterHeaderStyle}" shared:ColumnFilterLookupConverter.Filters="{Binding EndpointHeaderFilters}" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.AutomationId="NetworkEndpointListing" CanUserResizeColumns="True">
    <DataGrid.Style><Style TargetType="DataGrid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEndpointScope}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DataGrid.Style>
    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Tag" Value="{Binding DataContext,RelativeSource={RelativeSource AncestorType=DataGrid}}"/><Setter Property="ContextMenu"><Setter.Value>
     <ContextMenu DataContext="{Binding PlacementTarget,RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Go to process" Command="{Binding Tag.GoToEndpointProcessCommand}" CommandParameter="{Binding DataContext}"/>
      <MenuItem Header="Chat about" Command="{Binding Tag.ChatAboutCommand}" CommandParameter="{Binding DataContext}" Visibility="{Binding Tag.IsAiAvailable, Converter={StaticResource BoolToVisibilityConverter}}"/><MenuItem Header="Review record" Command="{Binding Tag.ReviewRecordCommand}" CommandParameter="{Binding DataContext}" Visibility="{Binding Tag.IsAiAvailable, Converter={StaticResource BoolToVisibilityConverter}}"/>
      <MenuItem Header="Find related activity" Command="{Binding Tag.FindRelatedProcessActivityCommand}" CommandParameter="{Binding DataContext}" Visibility="{Binding Tag.IsAiAvailable, Converter={StaticResource BoolToVisibilityConverter}}"/>
     </ContextMenu>
    </Setter.Value></Setter></Style></DataGrid.RowStyle>
    <DataGrid.Columns>
     <DataGridTextColumn Header="Observation / window start UTC" Binding="{Binding FirstObservedUtc,StringFormat=yyyy-MM-dd HH:mm:ss.fff}" SortMemberPath="ObservedUtc" Width="180"/>
     <DataGridTextColumn Header="Last observation / window end UTC" Binding="{Binding LastObservedUtc,StringFormat=yyyy-MM-dd HH:mm:ss.fff}" SortMemberPath="LastObservedUtc" Width="180"/>
     <DataGridTextColumn Header="First absent UTC" Binding="{Binding FirstAbsentUtc,StringFormat=yyyy-MM-dd HH:mm:ss.fff}" SortMemberPath="FirstAbsentUtc" Width="180"/>
     <DataGridTextColumn Header="Family" Binding="{Binding Observation.Native.Family}" SortMemberPath="Family" Width="90"/>
     <DataGridTextColumn Header="Local endpoint" Binding="{Binding Observation.Native.LocalPresentation}" SortMemberPath="LocalAddress" Width="190"/>
     <DataGridTextColumn Header="Port" Binding="{Binding Observation.Native.LocalPort}" SortMemberPath="LocalPort" Width="70"/>
     <DataGridTextColumn Header="Remote endpoint" Binding="{Binding Observation.Native.RemotePresentation}" SortMemberPath="RemoteEndpoint" Width="190"/>
     <DataGridTextColumn Header="TCP state" Binding="{Binding Observation.Native.TcpState}" SortMemberPath="TcpState" Width="90"/>
     <DataGridTextColumn Header="PID observed" Binding="{Binding Observation.Native.ProcessId}" SortMemberPath="ProcessId" Width="95"/>
     <DataGridTextColumn Header="Process name" Binding="{Binding Observation.Native.ProcessNameDisplay}" SortMemberPath="ProcessName" Width="160"/>
     <DataGridTextColumn Header="Image path" Binding="{Binding Observation.Native.ImagePathDisplay}" SortMemberPath="ImagePath" Width="260"/>
     <DataGridTextColumn Header="Command line" Binding="{Binding Observation.Native.CommandLineDisplay}" SortMemberPath="CommandLine" Width="300"/>
     <DataGridTextColumn Header="Ownership" Binding="{Binding Observation.Native.Ownership}" SortMemberPath="Ownership" Width="140"/>
     <DataGridTextColumn Header="Coverage gap" Binding="{Binding HasContinuityGap}" SortMemberPath="CoverageGap" Width="110"/>
    </DataGrid.Columns>
   </DataGrid>
   <DataGrid x:Name="NetworkGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" AutoGenerateColumns="False"
    CanUserAddRows="False" IsReadOnly="True" Sorting="SortNetwork" CanUserSortColumns="True" SelectionMode="Single" ColumnHeaderStyle="{StaticResource ColumnFilterHeaderStyle}"
    EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.AutomationId="NetworkWorkspaceListing" CanUserResizeColumns="True">
    <DataGrid.Style><Style TargetType="DataGrid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsEndpointScope}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DataGrid.Style>
    <DataGrid.Columns>
     <DataGridTextColumn Header="Captured UTC" SortMemberPath="CapturedUtc" Binding="{Binding CapturedUtc, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" Width="180"/>
     <DataGridTextColumn Header="Process" SortMemberPath="Process" Binding="{Binding ProcessName}" Width="140"/>
     <DataGridTextColumn Header="Observation" SortMemberPath="ObservationKind" Binding="{Binding ObservationDisplay}" Width="190"/>
     <DataGridTextColumn Header="Provider" SortMemberPath="Provider" Binding="{Binding Provider}" Width="210"/>
     <DataGridTextColumn Header="PID" SortMemberPath="ProcessId" Binding="{Binding ProcessId}" Width="65"/>
     <DataGridTextColumn Header="Local endpoint" Binding="{Binding LocalEndpoint.Presentation}" SortMemberPath="LocalEndpoint" Width="180"/>
     <DataGridTextColumn Header="Protocol" SortMemberPath="Protocol" Binding="{Binding Protocol}" Width="80"/>
     <DataGridTextColumn Header="Direction" SortMemberPath="Direction" Binding="{Binding Direction}" Width="100"/>
     <DataGridTextColumn Header="Source address" SortMemberPath="SourceAddress" Binding="{Binding SourceEndpoint.AddressPresentation}" Width="160"/>
     <DataGridTextColumn Header="Source port" SortMemberPath="SourcePort" Binding="{Binding SourceEndpoint.Port}" Width="85"/>
     <DataGridTextColumn Header="Destination address" SortMemberPath="DestinationAddress" Binding="{Binding DestinationEndpoint.AddressPresentation}" Width="160"/>
     <DataGridTextColumn Header="Destination port" SortMemberPath="DestinationPort" Binding="{Binding DestinationEndpoint.Port}" Width="110"/>
     <DataGridTextColumn Header="DNS query" SortMemberPath="QueryName" Binding="{Binding QueryName}" Width="170"/>
     <DataGridTextColumn Header="DNS status" SortMemberPath="QueryStatus" Binding="{Binding QueryStatus}" Width="100"/>
     <DataGridTextColumn Header="DNS results" SortMemberPath="QueryResults" Binding="{Binding QueryResults}" Width="190"/>
    </DataGrid.Columns>
   </DataGrid>
   </Grid>
  </DockPanel>
  <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"/>
  <TabControl Grid.Row="2" Margin="6" SelectedIndex="{Binding DetailsTabIndex, Mode=TwoWay}">
   <TabItem Header="Properties">
  <DockPanel>
   <StackPanel DockPanel.Dock="Top"><Button Content="Clear property filters" Command="{Binding ClearPropertiesCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding InspectorPaneViewModel.HeaderText}" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding InspectorPaneViewModel.SubtitleText}" TextWrapping="Wrap"/></StackPanel>
   <DataGrid x:Name="PropertiesGrid" ItemsSource="{Binding PropertiesView}" CanUserSortColumns="True" Sorting="SortProperties" ColumnHeaderStyle="{StaticResource ColumnFilterHeaderStyle}" shared:ColumnFilterLookupConverter.Filters="{Binding PropertiesHeaderFilters}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" AutomationProperties.AutomationId="NetworkWorkspaceProperties" CanUserResizeColumns="True">
    <DataGrid.Columns><DataGridTextColumn Header="Group" SortMemberPath="Group" Binding="{Binding Group}" Width="100"/><DataGridTextColumn Header="Property" SortMemberPath="Name" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="Captured value / provenance" SortMemberPath="Value" Binding="{Binding Value}" Width="*"/></DataGrid.Columns>
   </DataGrid>
  </DockPanel>
   </TabItem>
   <TabItem Header="Process overview">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="{Binding OverviewStatus}" TextWrapping="Wrap" Margin="6"/>
     <selectedProcess:ProcessOverviewView DataContext="{Binding ProcessOverview}"/>
    </DockPanel>
   </TabItem>
   <TabItem Header="Chats" Visibility="{Binding IsAiAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
    <ai:ProcessConversationView DataContext="{Binding ObjectConversationViewModel}"/>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
