<UserControl x:Class="ProcInsider.Features.InvestigationWorkspaces.PersistenceWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shared="clr-namespace:ProcInsider.Views.Shared" xmlns:local="clr-namespace:ProcInsider.Features.InvestigationWorkspaces"
 xmlns:ai="clr-namespace:ProcInsider.Views.Features.Ai">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Views/Shared/ColumnHeaderResources.xaml"/></ResourceDictionary.MergedDictionaries><Style x:Key="CompactPersistenceCell" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip"><Setter.Value><ToolTip><ScrollViewer MaxHeight="280" MaxWidth="900" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><TextBox Text="{Binding PlacementTarget.Text,RelativeSource={RelativeSource AncestorType=ToolTip},Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/></ScrollViewer></ToolTip></Setter.Value></Setter></Style><BooleanToVisibilityConverter x:Key="Visible"/></ResourceDictionary></UserControl.Resources>
 <Grid Background="White">
  <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="6"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
  <DockPanel Margin="5">
   <StackPanel DockPanel.Dock="Top">
    <WrapPanel>
     <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}" DisplayMemberPath="Display" MinWidth="240" ToolTip="Recorded host/capture/source context; multiple contexts require explicit selection."/>
    </WrapPanel>
    <WrapPanel><Button Content="Baseline snapshot" Command="{Binding RebaselineCommand}" ToolTip="Create on-demand persistence baseline snapshot using Agent" AutomationProperties.AutomationId="PersistenceBaselineSnapshot"/><Button Content="Differential snapshot" Command="{Binding CollectCommand}" ToolTip="Create on-demand persistence differential snapshot using Agent" AutomationProperties.AutomationId="PersistenceDifferentialSnapshot"/></WrapPanel>
    <TextBlock Text="{Binding StatusHeadline}" TextWrapping="Wrap" Margin="0,4" AutomationProperties.AutomationId="PersistenceStatusSummary"/><ScrollViewer x:Name="CoverageDiagnostics" MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Full recorded coverage diagnostics"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="PersistenceStatus"/></ScrollViewer>
    <TextBlock Text="{Binding ActionStatus}" TextWrapping="Wrap"/>
   </StackPanel>
   <WrapPanel DockPanel.Dock="Bottom"><Button Content="Previous" Command="{Binding PreviousCommand}"/><Button Content="Next" Command="{Binding NextCommand}"/><TextBlock Text="{Binding MatchingRows,StringFormat={}{0:N0} matching records}" VerticalAlignment="Center" Margin="6,0"/></WrapPanel>
   <Grid>
    <DataGrid x:Name="CurrentGrid" Visibility="{Binding IsCurrent,Converter={StaticResource Visible}}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow,Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="28" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True" Sorting="SortListing" ColumnHeaderStyle="{StaticResource ColumnFilterHeaderStyle}" shared:ColumnFilterLookupConverter.Filters="{Binding HeaderFilters}" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.AutomationId="PersistenceCurrentListing">
     <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Tag" Value="{Binding DataContext,RelativeSource={RelativeSource AncestorType=DataGrid}}"/><Setter Property="ContextMenu"><Setter.Value><ContextMenu DataContext="{Binding PlacementTarget,RelativeSource={RelativeSource Self}}"><MenuItem Header="Chat about" Command="{Binding Tag.ChatAboutCommand}" CommandParameter="{Binding DataContext}" Visibility="{Binding Tag.IsAiAvailable,Converter={StaticResource Visible}}"/><MenuItem Header="Review record" Command="{Binding Tag.ReviewRecordCommand}" CommandParameter="{Binding DataContext}" Visibility="{Binding Tag.IsAiAvailable,Converter={StaticResource Visible}}"/><MenuItem Header="Find related activity" Command="{Binding Tag.FindRelatedActivityCommand}" CommandParameter="{Binding DataContext}" Visibility="{Binding Tag.IsAiAvailable,Converter={StaticResource Visible}}"/></ContextMenu></Setter.Value></Setter></Style></DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Type" Binding="{Binding Type}" SortMemberPath="Type" Width="110"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="170"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Location" Binding="{Binding Location}" SortMemberPath="Location" Width="260"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Target / Command" Binding="{Binding TargetCommand}" SortMemberPath="TargetCommand" Width="260"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Principal" Binding="{Binding Principal}" SortMemberPath="Principal" Width="200"/>
      <DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="First observed UTC" Binding="{Binding FirstObservedUtc,StringFormat=yyyy-MM-dd HH:mm:ss.fff}" SortMemberPath="FirstObservedUtc" Width="180"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Last changed observed UTC" Binding="{Binding LastChangedUtc,StringFormat=yyyy-MM-dd HH:mm:ss.fff}" SortMemberPath="LastChangedUtc" Width="190"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Last confirmed UTC" Binding="{Binding LastConfirmedUtc,StringFormat=yyyy-MM-dd HH:mm:ss.fff}" SortMemberPath="LastConfirmedUtc" Width="180"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Freshness" Binding="{Binding Freshness}" SortMemberPath="Freshness" Width="210"/>
     </DataGrid.Columns>
    </DataGrid>
    <DataGrid x:Name="ChangesGrid" Visibility="{Binding IsChanges,Converter={StaticResource Visible}}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow,Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="28" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True" Sorting="SortListing" ColumnHeaderStyle="{StaticResource ColumnFilterHeaderStyle}" shared:ColumnFilterLookupConverter.Filters="{Binding HeaderFilters}" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.AutomationId="PersistenceChangesListing">
     <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Tag" Value="{Binding DataContext,RelativeSource={RelativeSource AncestorType=DataGrid}}"/><Setter Property="ContextMenu"><Setter.Value><ContextMenu DataContext="{Binding PlacementTarget,RelativeSource={RelativeSource Self}}"><MenuItem Header="Chat about" Command="{Binding Tag.ChatAboutCommand}" CommandParameter="{Binding DataContext}" Visibility="{Binding Tag.IsAiAvailable,Converter={StaticResource Visible}}"/><MenuItem Header="Review record" Command="{Binding Tag.ReviewRecordCommand}" CommandParameter="{Binding DataContext}" Visibility="{Binding Tag.IsAiAvailable,Converter={StaticResource Visible}}"/><MenuItem Header="Find related activity" Command="{Binding Tag.FindRelatedActivityCommand}" CommandParameter="{Binding DataContext}" Visibility="{Binding Tag.IsAiAvailable,Converter={StaticResource Visible}}"/></ContextMenu></Setter.Value></Setter></Style></DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Observed UTC" Binding="{Binding ObservedUtc,StringFormat=yyyy-MM-dd HH:mm:ss.fff}" SortMemberPath="ObservedUtc" Width="180"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Change" Binding="{Binding Change}" SortMemberPath="Change" Width="100"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Type" Binding="{Binding Type}" SortMemberPath="Type" Width="110"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="170"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Location" Binding="{Binding Location}" SortMemberPath="Location" Width="260"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Target / Command" Binding="{Binding TargetCommand}" SortMemberPath="TargetCommand" Width="260"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Principal" Binding="{Binding Principal}" SortMemberPath="Principal" Width="200"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Generation" Binding="{Binding Generation}" SortMemberPath="Generation" Width="190"/>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
  </DockPanel>
  <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"/>
  <TabControl Grid.Row="2" Margin="5" SelectedIndex="{Binding DetailsTabIndex,Mode=TwoWay}"><TabItem Header="Native properties / Before / After"><local:DataPersistencePropertiesView/></TabItem><TabItem Header="Object observation history"><local:DataPersistenceHistoryView/></TabItem><TabItem Header="Chats" Visibility="{Binding IsAiAvailable,Converter={StaticResource Visible}}"><ai:ProcessConversationView DataContext="{Binding ObjectConversationViewModel}"/></TabItem></TabControl>
 </Grid>
</UserControl>
