<UserControl x:Class="ProcInsider.Features.InvestigationWorkspaces.DataPersistenceHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="clr-namespace:ProcInsider.Views.Shared">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Views/Shared/ColumnHeaderResources.xaml"/></ResourceDictionary.MergedDictionaries><Style x:Key="CompactPersistenceCell" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip"><Setter.Value><ToolTip><ScrollViewer MaxHeight="280" MaxWidth="900" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><TextBox Text="{Binding PlacementTarget.Text,RelativeSource={RelativeSource AncestorType=ToolTip},Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/></ScrollViewer></ToolTip></Setter.Value></Setter></Style></ResourceDictionary></UserControl.Resources>
 <DockPanel><WrapPanel DockPanel.Dock="Top"><Button Content="Clear history filters" Command="{Binding ClearHistoryCommand}"/><Button Content="Previous history page" Command="{Binding PreviousHistoryCommand}"/><Button Content="Next history page" Command="{Binding NextHistoryCommand}"/><TextBlock Text="{Binding MatchingHistory,StringFormat={}{0:N0} matching history records}" VerticalAlignment="Center"/></WrapPanel>
  <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding HistoryView}" SelectedItem="{Binding SelectedHistory,Mode=TwoWay}" CanUserSortColumns="True" CanUserResizeColumns="True" Sorting="SortHistory" ColumnHeaderStyle="{StaticResource ColumnFilterHeaderStyle}" shared:ColumnFilterLookupConverter.Filters="{Binding HistoryFilters}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="28" AutomationProperties.AutomationId="PersistenceObjectHistory">
   <DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Observed UTC" SortMemberPath="ObservedUtc" Binding="{Binding ObservedUtc,StringFormat=yyyy-MM-dd HH:mm:ss.fff}" Width="180"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Change" SortMemberPath="Change" Binding="{Binding Change}" Width="100"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Type" SortMemberPath="Type" Binding="{Binding Type}" Width="100"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Name" SortMemberPath="Name" Binding="{Binding Name}" Width="160"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Location" SortMemberPath="Location" Binding="{Binding Location}" Width="230"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Target / Command" SortMemberPath="TargetCommand" Binding="{Binding TargetCommand}" Width="230"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Principal" SortMemberPath="Principal" Binding="{Binding Principal}" Width="180"/><DataGridTextColumn ElementStyle="{StaticResource CompactPersistenceCell}" Header="Generation" SortMemberPath="Generation" Binding="{Binding Generation}" Width="180"/></DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</UserControl>
