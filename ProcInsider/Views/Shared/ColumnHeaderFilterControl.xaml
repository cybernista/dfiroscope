<UserControl x:Class="ProcInsider.Views.Shared.ColumnHeaderFilterControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></UserControl.Resources>
 <DockPanel>
  <Button x:Name="FilterButton" DockPanel.Dock="Right" Width="22" Margin="4,0,0,0" Padding="2" Click="OpenFilter"
   ToolTip="Filter this column" AutomationProperties.Name="{Binding Title, ElementName=Root, StringFormat=Filter {0}}">
   <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Style.Triggers><DataTrigger Binding="{Binding Filter.IsActive, ElementName=Root}" Value="True"><Setter Property="Background" Value="#B8D9FA"/></DataTrigger>
     <DataTrigger Binding="{Binding Filter, ElementName=Root}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
   </Style></Button.Style>
   <Path Data="M0,0 L12,0 L8,5 L8,10 L4,12 L4,5 Z" Fill="#858585" Width="12" Height="12" Stretch="Uniform"/>
  </Button>
  <TextBlock Text="{Binding Title, ElementName=Root}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
  <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom" StaysOpen="False"
    IsOpen="{Binding Filter.IsOpen, ElementName=Root, Mode=TwoWay}" Closed="PopupClosed" Opened="PopupOpened">
   <Border BorderBrush="#888" BorderThickness="1" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Padding="12" Width="350"
    DataContext="{Binding Filter, ElementName=Root}" PreviewKeyDown="PopupKeyDown">
    <StackPanel>
     <TextBlock Text="{Binding Title, ElementName=Root, StringFormat=Filter: {0}}" FontWeight="Bold" Margin="0,0,0,8"/>
     <StackPanel Visibility="{Binding IsValues, Converter={StaticResource BoolVisibility}}">
      <TextBox Text="{Binding ValueSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Find distinct values" ToolTip="Find values (literal text, ignoring case)"/>
      <StackPanel Orientation="Horizontal" Margin="0,6"><Button Content="Select all values" Command="{Binding SelectAllCommand}" Padding="5,3"/><Button Content="Select none" Command="{Binding SelectNoneCommand}" Margin="6,0" Padding="5,3"/></StackPanel>
      <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="17"/></Grid.ColumnDefinitions>
       <Button Content="{Binding ValueSortHeader}" Command="{Binding SortValuesCommand}" HorizontalContentAlignment="Left" Padding="5,3" ToolTip="Sort all matching values by value"/>
       <Button Grid.Column="1" Content="{Binding CountSortHeader}" Command="{Binding SortCountsCommand}" HorizontalContentAlignment="Right" Padding="5,3" ToolTip="Sort all matching values by matching row count"/>
      </Grid>
      <ListBox ItemsSource="{Binding Choices}" Height="220" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" ToolTip="{Binding Label}"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></CheckBox>
        <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0:N0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,0"/>
       </Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="Loading values…" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}"/>
      <TextBlock Text="{Binding ChoiceStatus}" TextWrapping="Wrap" Margin="0,5"/>
     </StackPanel>
     <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Contains"/><TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Contains text"/></StackPanel>
     <StackPanel Visibility="{Binding IsRange, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="From / minimum (optional)"/><TextBox Text="{Binding Lower, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Minimum or start time"/>
      <TextBlock Text="To / maximum (optional)" Margin="0,6,0,0"/><TextBox Text="{Binding Upper, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Maximum or end time"/>
      <CheckBox Content="Include unavailable values" IsChecked="{Binding IncludeMissing}" Margin="0,6"/>
     </StackPanel>
     <TextBlock Text="{Binding InputHint}" TextWrapping="Wrap" Margin="0,5"/>
     <TextBlock Text="{Binding Error}" Foreground="#A02020" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Apply" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" Padding="10,4"/>
      <Button Content="Clear" Command="{Binding ClearCommand}" Padding="10,4" Margin="6,0"/>
      <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="10,4"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </Popup>
 </DockPanel>
</UserControl>
