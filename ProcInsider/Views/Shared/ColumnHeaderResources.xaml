<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="clr-namespace:ProcInsider.Views.Shared">
 <shared:ColumnFilterLookupConverter x:Key="ColumnFilterLookup"/>
 <Style x:Key="ColumnFilterHeaderStyle" TargetType="DataGridColumnHeader">
  <!-- Draw the sort state explicitly; native theme renderers can omit it behind custom header content. -->
  <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
  <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
  <Setter Property="BorderThickness" Value="0,0,1,1"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="5,3"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="DataGridColumnHeader">
    <Grid SnapsToDevicePixels="True">
     <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}"
             BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="4"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Path x:Name="SortArrow" Width="8" Height="4" HorizontalAlignment="Center"
             Fill="{TemplateBinding Foreground}" Stretch="Fill" Visibility="Hidden" IsHitTestVisible="False"/>
       <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                         HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Grid>
     </Border>
     <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="6" Cursor="SizeWE">
      <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
     </Thumb>
     <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE">
      <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
     </Thumb>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="SortDirection" Value="Ascending">
      <Setter TargetName="SortArrow" Property="Data" Value="M0,4 L4,0 L8,4 Z"/>
      <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
     </Trigger>
     <Trigger Property="SortDirection" Value="Descending">
      <Setter TargetName="SortArrow" Property="Data" Value="M0,0 L4,4 L8,0 Z"/>
      <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
     </Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
    <shared:ColumnHeaderFilterControl Title="{Binding}">
     <shared:ColumnHeaderFilterControl.Filter><MultiBinding Converter="{StaticResource ColumnFilterLookup}">
      <Binding Path="DataContext.HeaderFilters" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
      <Binding Path="Column.SortMemberPath" RelativeSource="{RelativeSource AncestorType=DataGridColumnHeader}"/>
     </MultiBinding></shared:ColumnHeaderFilterControl.Filter>
    </shared:ColumnHeaderFilterControl>
  </DataTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="SortDirection" Value="Ascending">
    <Setter Property="Background" Value="#DCDCDC"/>
    <Setter Property="AutomationProperties.HelpText" Value="Sorted ascending"/>
   </Trigger>
   <Trigger Property="SortDirection" Value="Descending">
    <Setter Property="Background" Value="#DCDCDC"/>
    <Setter Property="AutomationProperties.HelpText" Value="Sorted descending"/>
   </Trigger>
  </Style.Triggers>
 </Style>
</ResourceDictionary>
