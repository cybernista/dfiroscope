<UserControl x:Class="ProcInsider.Views.Features.Filesystem.DataFilesystemArtifactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button Content="Refresh Artifacts"
                    Command="{Binding RefreshArtifactsCommand}"
                    Padding="10,3" Margin="0,0,10,0"/>
            <Button Content="Import File"
                    Command="{Binding DataContext.QueueArtifactFileImportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="10,3" Margin="0,0,10,0"/>
            <Button Content="Import Folder"
                    Command="{Binding DataContext.QueueArtifactFolderImportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="10,3" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding ArtifactsView}"
                  SelectedItem="{Binding SelectedArtifact, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  Margin="5"
                  FontSize="11">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimestampDisplay}" Width="135"
                                    SortMemberPath="TimestampUtc"/>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="125"
                                    SortMemberPath="Kind"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"
                                    SortMemberPath="Status"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"
                                    SortMemberPath="Name"/>
                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="270"
                                    SortMemberPath="Summary">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding Summary}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Size" Binding="{Binding FileSizeDisplay}" Width="85"
                                    SortMemberPath="FileSizeBytes"/>
                <DataGridTextColumn Header="Prefetch Process" Binding="{Binding ProcessName}" Width="150"
                                    SortMemberPath="ProcessName"/>
                <DataGridTextColumn Header="Runs" Binding="{Binding RunCount}" Width="65"
                                    SortMemberPath="RunCount"/>
                <DataGridTextColumn Header="Last Run" Binding="{Binding LastRunDisplay}" Width="135"
                                    SortMemberPath="LastRunDisplay"/>
                <DataGridTextColumn Header="Path" Binding="{Binding SourcePath}" Width="320"
                                    SortMemberPath="SourcePath">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding SourcePath}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="SHA256" Binding="{Binding Sha256Hash}" Width="220"
                                    SortMemberPath="Sha256Hash">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding Sha256Hash}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="260"
                                    SortMemberPath="ErrorMessage">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Margin="5,0,5,5">
            <Run Text="Filesystem artifacts: "/>
            <Run Text="{Binding Artifacts.Count, Mode=OneWay}" FontWeight="Bold"/>
        </TextBlock>
    </Grid>
</UserControl>
