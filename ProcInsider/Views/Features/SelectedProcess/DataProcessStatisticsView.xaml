<UserControl x:Class="ProcInsider.Views.Features.SelectedProcess.DataProcessStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="5"
                   Text="{Binding StatusMessage}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>

        <UniformGrid Grid.Row="1" Columns="4" Margin="5,0,5,5">
            <Border Padding="8"
                    Margin="0,0,5,0"
                    Background="#FFF7FBFF"
                    BorderBrush="#FFD7E7F5"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Process"
                               Foreground="#555555"/>
                    <TextBlock Text="{Binding SelectedProcessHeader}"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Padding="8"
                    Margin="0,0,5,0"
                    Background="#FFF7FBFF"
                    BorderBrush="#FFD7E7F5"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CPU Time"
                               Foreground="#555555"/>
                    <TextBlock Text="{Binding TotalCpuTime}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border Padding="8"
                    Margin="0,0,5,0"
                    Background="#FFF7FBFF"
                    BorderBrush="#FFD7E7F5"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Bytes Read"
                               Foreground="#555555"/>
                    <TextBlock Text="{Binding TotalReadBytes}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border Padding="8"
                    Background="#FFF7FBFF"
                    BorderBrush="#FFD7E7F5"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Bytes Written"
                               Foreground="#555555"/>
                    <TextBlock Text="{Binding TotalWrittenBytes}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2"
                Margin="5,0,5,5"
                Padding="8"
                Background="#FFFFFFFF"
                BorderBrush="#FFD8D8D8"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <ProgressBar Width="90"
                                     Height="6"
                                     Margin="8,5,0,0"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsTrendLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding TrendStatusMessage}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TrendWindow}"
                                   Foreground="#555555"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>

                <TextBlock Grid.Row="1"
                           Margin="0,10,0,0"
                           Text="{Binding TrendStatusMessage}"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Visibility="{Binding HasTrendData, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                <Grid Grid.Row="1"
                      Margin="0,8,0,0"
                      Visibility="{Binding HasTrendData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="CPU s/min" FontWeight="SemiBold"/>
                        <Border Grid.Row="1"
                                Margin="0,4,0,4"
                                Background="#FFF8FBFF"
                                BorderBrush="#FFD7E7F5"
                                BorderThickness="1">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="240" Height="80">
                                    <Polyline Points="{Binding CpuTrendPoints}"
                                              Stroke="#FF2F6FED"
                                              StrokeThickness="2"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding CpuTrendPeak}"
                                   Foreground="#555555"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <Grid Grid.Column="1" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Read bytes/min" FontWeight="SemiBold"/>
                        <Border Grid.Row="1"
                                Margin="0,4,0,4"
                                Background="#FFF8FBFF"
                                BorderBrush="#FFD7E7F5"
                                BorderThickness="1">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="240" Height="80">
                                    <Polyline Points="{Binding ReadTrendPoints}"
                                              Stroke="#FF12845B"
                                              StrokeThickness="2"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding ReadTrendPeak}"
                                   Foreground="#555555"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Write bytes/min" FontWeight="SemiBold"/>
                        <Border Grid.Row="1"
                                Margin="0,4,0,4"
                                Background="#FFF8FBFF"
                                BorderBrush="#FFD7E7F5"
                                BorderThickness="1">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="240" Height="80">
                                    <Polyline Points="{Binding WrittenTrendPoints}"
                                              Stroke="#FFB45F06"
                                              StrokeThickness="2"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding WrittenTrendPeak}"
                                   Foreground="#555555"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
