<UserControl x:Class="ProcInsider.Views.Features.SelectedProcess.DataProcessPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="5,5,5,0"
                Padding="8"
                Background="#FFF7FBFF"
                BorderBrush="#FFD7E7F5"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding HeaderText}"
                           FontWeight="SemiBold"
                           FontSize="14"/>
                <TextBlock Text="{Binding SubtitleText}"
                           Margin="0,4,0,0"
                           Foreground="#555555"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <TextBlock Margin="12"
                       Text="Select a process in the main grid to inspect its properties."
                       Foreground="#666666"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Visibility="{Binding HasProcessSelected, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

            <DataGrid ItemsSource="{Binding Properties}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      HorizontalScrollBarVisibility="Auto"
                      Margin="5"
                      FontSize="11"
                      Visibility="{Binding HasProcessSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="115" MinWidth="80" SortMemberPath="Group"/>
                    <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="180" MinWidth="110" SortMemberPath="Name"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" MinWidth="260"
                                        SortMemberPath="Value">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Value}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Expander Grid.Row="2"
                  Header="Data origin"
                  IsExpanded="False"
                  Margin="5,0,5,5"
                  Visibility="{Binding HasProcessSelected, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid MinHeight="80" MaxHeight="220">
                <TextBlock Margin="12"
                           Text="No data-origin records are available for this process."
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Visibility="{Binding HasDataOrigin, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                <DataGrid ItemsSource="{Binding DataOrigin}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          FontSize="11"
                          Visibility="{Binding HasDataOrigin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Field" Binding="{Binding FieldName}" Width="155" MinWidth="100" SortMemberPath="FieldName"/>
                        <DataGridTextColumn Header="Source run" Binding="{Binding SourceRunId}" Width="250" MinWidth="180" SortMemberPath="SourceRunId"/>
                        <DataGridTextColumn Header="Observation" Binding="{Binding ObservationId}" Width="250" MinWidth="180" SortMemberPath="ObservationId"/>
                        <DataGridTextColumn Header="Selection rule" Binding="{Binding SelectionRule}" Width="*" MinWidth="300" SortMemberPath="SelectionRule">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding SelectionRule}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Expander>
    </Grid>
</UserControl>
