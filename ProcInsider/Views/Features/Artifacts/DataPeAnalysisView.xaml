<UserControl x:Class="ProcInsider.Views.Features.Artifacts.DataPeAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button Content="Refresh PE"
                    Command="{Binding RefreshPeAnalysesCommand}"
                    Padding="10,3" Margin="0,0,10,0"/>
            <Button Content="Analyze / Complete Strings"
                    Command="{Binding DataContext.AnalyzeSelectedProcessImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="10,3" Margin="0,0,10,0"/>
            <Button Content="Analyze Selected Dump"
                    Command="{Binding DataContext.AnalyzeSelectedDumpPeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="10,3" Margin="0,0,10,0"/>
            <TextBlock Text="String filter"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>
            <TextBox Text="{Binding StringFilterText, UpdateSourceTrigger=PropertyChanged}"
                     Width="220"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedPeSourceTabIndex, Mode=TwoWay}"
                    Margin="5">
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="{Binding DiskPeAnalyses.Count, StringFormat='PE On Disk ({0})'}"/>
                </TabItem.Header>
                <DataGrid ItemsSource="{Binding DiskPeAnalysesView}"
                          SelectedItem="{Binding SelectedDiskPeAnalysis, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          Margin="0,5,0,0"
                          FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Analyzed" Binding="{Binding AnalyzedDisplay}" Width="135" SortMemberPath="AnalyzedUtc"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85" SortMemberPath="Status"/>
                        <DataGridTextColumn Header="PE" Binding="{Binding PeKind}" Width="70" SortMemberPath="PeKind"/>
                        <DataGridTextColumn Header="Machine" Binding="{Binding Machine}" Width="85" SortMemberPath="Machine"/>
                        <DataGridTextColumn Header="Subsystem" Binding="{Binding Subsystem}" Width="120" SortMemberPath="Subsystem"/>
                        <DataGridTextColumn Header="Sections" Binding="{Binding SectionCount}" Width="70" SortMemberPath="SectionCount"/>
                        <DataGridTextColumn Header="Imports" Binding="{Binding ImportCount}" Width="70" SortMemberPath="ImportCount"/>
                        <DataGridTextColumn Header="Exports" Binding="{Binding ExportCount}" Width="70" SortMemberPath="ExportCount"/>
                        <DataGridTextColumn Header="Strings" Binding="{Binding PrintableStringCount}" Width="70" SortMemberPath="PrintableStringCount"/>
                        <DataGridTextColumn Header="String State" Binding="{Binding StringAnalysisStatus}" Width="90" SortMemberPath="StringAnalysisStatus"/>
                        <DataGridTextColumn Header="Samples" Binding="{Binding PrintableStringSamplesDisplay}" Width="75" SortMemberPath="PrintableStringSamplesDisplay"/>
                        <DataGridTextColumn Header="Truncation" Binding="{Binding StringTruncationStatus}" Width="145" SortMemberPath="StringTruncationStatus"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="280" SortMemberPath="FilePath">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="SHA256" Binding="{Binding Sha256Hash}" Width="220" SortMemberPath="Sha256Hash">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Sha256Hash}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="240" SortMemberPath="ErrorMessage">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="{Binding MemoryDumpPeAnalyses.Count, StringFormat='PE From Memory/Dump ({0})'}"/>
                </TabItem.Header>
                <DataGrid ItemsSource="{Binding MemoryDumpPeAnalysesView}"
                          SelectedItem="{Binding SelectedMemoryDumpPeAnalysis, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          Margin="0,5,0,0"
                          FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Analyzed" Binding="{Binding AnalyzedDisplay}" Width="135" SortMemberPath="AnalyzedUtc"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding SourceKind}" Width="120" SortMemberPath="SourceKind"/>
                        <DataGridTextColumn Header="Artifact" Binding="{Binding SourceArtifactId}" Width="150" SortMemberPath="SourceArtifactId"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85" SortMemberPath="Status"/>
                        <DataGridTextColumn Header="PE" Binding="{Binding PeKind}" Width="70" SortMemberPath="PeKind"/>
                        <DataGridTextColumn Header="Machine" Binding="{Binding Machine}" Width="85" SortMemberPath="Machine"/>
                        <DataGridTextColumn Header="Subsystem" Binding="{Binding Subsystem}" Width="120" SortMemberPath="Subsystem"/>
                        <DataGridTextColumn Header="Strings" Binding="{Binding PrintableStringCount}" Width="70" SortMemberPath="PrintableStringCount"/>
                        <DataGridTextColumn Header="String State" Binding="{Binding StringAnalysisStatus}" Width="90" SortMemberPath="StringAnalysisStatus"/>
                        <DataGridTextColumn Header="Samples" Binding="{Binding PrintableStringSamplesDisplay}" Width="75" SortMemberPath="PrintableStringSamplesDisplay"/>
                        <DataGridTextColumn Header="Truncation" Binding="{Binding StringTruncationStatus}" Width="145" SortMemberPath="StringTruncationStatus"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="280" SortMemberPath="FilePath">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="SHA256" Binding="{Binding Sha256Hash}" Width="220" SortMemberPath="Sha256Hash">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Sha256Hash}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="240" SortMemberPath="ErrorMessage">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Margin="5,0,5,5">
            <Run Text="Disk: "/>
            <Run Text="{Binding DiskPeAnalyses.Count, Mode=OneWay}" FontWeight="Bold"/>
            <Run Text="  Memory/Dump: "/>
            <Run Text="{Binding MemoryDumpPeAnalyses.Count, Mode=OneWay}" FontWeight="Bold"/>
        </TextBlock>
    </Grid>
</UserControl>
