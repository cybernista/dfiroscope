<UserControl x:Class="ProcInsider.Views.Features.Artifacts.DataModulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StaleArtifactRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStale}" Value="True">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                    <Setter Property="Opacity" Value="0.82"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Module list header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button Content="🔄 Refresh Modules"
                    Command="{Binding DataContext.RefreshSelectedModulesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="10,3" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Error message display -->
        <Border Grid.Row="1"
                Background="#FFF0F0"
                BorderBrush="#FFCCCC"
                BorderThickness="1"
                Margin="5"
                Padding="10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#CC0000"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Modules DataGrid -->
        <DataGrid Grid.Row="1"
                  x:Name="ModulesDataGrid"
                  ItemsSource="{Binding ModulesView}"
                  SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  Margin="5"
                  FontSize="11"
                  RowStyle="{StaticResource StaleArtifactRowStyle}"
                  Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVisibilityConverter}}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"
                                    SortMemberPath="Status"/>

                <DataGridTextColumn Header="Module Name" Binding="{Binding ModuleName}" Width="150"
                                    SortMemberPath="ModuleName"/>

                <DataGridTextColumn Header="Full Path" Binding="{Binding FullPath}" Width="250"
                                    SortMemberPath="FullPath">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding FullPath}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Base Address" Binding="{Binding BaseAddress}" Width="120"
                                    SortMemberPath="BaseAddress">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Size" Binding="{Binding ModuleMemorySize}" Width="80"
                                    SortMemberPath="ModuleMemorySizeBytes"/>

                <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen}" Width="130"
                                    SortMemberPath="LastSeenUtc"/>

                <DataGridTextColumn Header="File Version" Binding="{Binding FileVersion}" Width="100"
                                    SortMemberPath="FileVersion"/>

                <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="130"
                                    SortMemberPath="CompanyName">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding CompanyName}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="150"
                                    SortMemberPath="Description">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding Description}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="SHA256 Hash" Binding="{Binding Sha256Hash}" Width="200"
                                    SortMemberPath="Sha256Hash">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding Sha256Hash}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Module count -->
        <TextBlock Grid.Row="2" Margin="5,0,5,5">
            <Run Text="Modules: "/>
            <Run Text="{Binding Modules.Count, Mode=OneWay}" FontWeight="Bold"/>
        </TextBlock>
    </Grid>
</UserControl>
