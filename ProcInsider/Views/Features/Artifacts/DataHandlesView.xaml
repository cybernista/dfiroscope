<UserControl x:Class="ProcInsider.Views.Features.Artifacts.DataHandlesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StaleArtifactRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStale}" Value="True">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                    <Setter Property="Opacity" Value="0.82"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button Content="Refresh Handles"
                    Command="{Binding DataContext.RefreshSelectedHandlesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="10,3" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FFF0F0"
                BorderBrush="#FFCCCC"
                BorderThickness="1"
                Margin="5"
                Padding="10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#CC0000"
                       TextWrapping="Wrap"/>
        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding HandlesView}"
                  SelectedItem="{Binding SelectedHandle, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  Margin="5"
                  FontSize="11"
                  RowStyle="{StaticResource StaleArtifactRowStyle}"
                  Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVisibilityConverter}}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"
                                    SortMemberPath="Status"/>

                <DataGridTextColumn Header="Handle" Binding="{Binding HandleValue}" Width="110"
                                    SortMemberPath="HandleValueNumeric">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Type" Binding="{Binding ObjectType}" Width="120"
                                    SortMemberPath="ObjectType"/>

                <DataGridTextColumn Header="Name" Binding="{Binding ObjectName}" Width="250"
                                    SortMemberPath="ObjectName">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding ObjectName}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Access" Binding="{Binding GrantedAccess}" Width="100"
                                    SortMemberPath="GrantedAccessValue">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen}" Width="130"
                                    SortMemberPath="LastSeenUtc"/>

                <DataGridTextColumn Header="Attributes" Binding="{Binding HandleAttributes}" Width="170"
                                    SortMemberPath="HandleAttributesValue">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding HandleAttributes}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Object Address" Binding="{Binding ObjectAddress}" Width="140"
                                    SortMemberPath="ObjectAddress">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Margin="5,0,5,5">
            <Run Text="Handles: "/>
            <Run Text="{Binding Handles.Count, Mode=OneWay}" FontWeight="Bold"/>
        </TextBlock>
    </Grid>
</UserControl>
