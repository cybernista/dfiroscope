<UserControl x:Class="ProcInsider.Views.Features.Ai.ExplorerAiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="ProviderRowTemplate">
            <Border IsEnabled="{Binding IsAvailable}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    BorderBrush="#C0C0C0" BorderThickness="0,0,0,1" Padding="3,6">
                <Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="1"/><Style.Triggers>
                    <DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Opacity" Value="0.45"/></DataTrigger>
                </Style.Triggers></Style></Border.Style>
                <Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Edit" Click="EditProviderClicked" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Make default" Command="{Binding SetDefaultProfileCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Remove" Command="{Binding RemoveProfileCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                </ContextMenu></Border.ContextMenu>
                <DockPanel>
                    <RadioButton GroupName="NextAiProvider" IsChecked="{Binding IsSelected, Mode=OneWay}" Checked="ProfileRadioChecked" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Use for the next interaction"/>
                    <StackPanel>
                        <WrapPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding DefaultLabel}" Foreground="#666666" Margin="8,0,0,0"/></WrapPanel>
                        <ComboBox x:Name="ProviderModelSelection" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding ModelName, Mode=OneWay}"
                                  DropDownOpened="ProviderModelsOpened" SelectionChanged="ProviderModelChanged" MinWidth="180" HorizontalAlignment="Left" ToolTip="{Binding ModelCatalogStatus}"/>
                        <TextBlock Text="{Binding Destination}" TextWrapping="Wrap"/><TextBlock Text="{Binding Endpoint}" Foreground="#666666" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ReadinessMessage}" Foreground="#805000" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Add provider" Click="NewProviderClicked" Padding="8,4" Margin="0,0,8,0"/>
                        <Button Content="{Binding VaultActionLabel}" Click="VaultClicked" IsEnabled="{Binding IsVaultStatusAvailable}" Padding="8,4" Margin="0,0,8,0"/>
                        <Button Content="Change Keystore password" Click="ChangePasswordClicked" IsEnabled="{Binding IsPasswordConfigured}" Padding="8,4"/>
                    </WrapPanel>
                    <TextBlock Text="The radio selection controls the next AI interaction. Make default changes the provider used at the next Viewer start. Right-click a provider to edit, make default or remove it." TextWrapping="Wrap"/>
                    <CheckBox Content="Allow HTTP on a private network for this session" IsChecked="{Binding AllowPrivateNetworkHttp}" Margin="0,8"
                              ToolTip="Private local endpoints only. Traffic is unencrypted; API keys are prohibited."/>
                    <TextBlock FontWeight="SemiBold" FontSize="15" Margin="0,12,0,4">Saved providers <Run x:Name="VaultStateRun" Text="{Binding VaultStateLabel, Mode=OneWay}">
                        <Run.Style><Style TargetType="Run"><Setter Property="Foreground" Value="#B00020"/><Style.Triggers>
                            <DataTrigger Binding="{Binding IsVaultUnlocked}" Value="True"><Setter Property="Foreground" Value="#17752A"/></DataTrigger>
                        </Style.Triggers></Style></Run.Style>
                    </Run></TextBlock>
                    <ItemsControl ItemsSource="{Binding AuthenticatedProfiles}" ItemTemplate="{StaticResource ProviderRowTemplate}"/>
                    <TextBlock FontWeight="SemiBold" FontSize="15" Margin="0,12,0,4">Saved providers <Run Text="[No authentication]" Foreground="#17752A"/></TextBlock>
                    <ItemsControl ItemsSource="{Binding AuthenticationFreeProfiles}" ItemTemplate="{StaticResource ProviderRowTemplate}"/>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#805000" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>

</UserControl>
