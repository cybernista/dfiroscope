<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ai="clr-namespace:ProcInsider.Views.Features.Ai">
    <BooleanToVisibilityConverter x:Key="AiCorrectionVisibility"/>
    <Style x:Key="AiCorrectionGuidanceStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="{Binding CorrectionGuidance}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="#805000"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding CorrectionGuidance}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AiTranscriptStyle" TargetType="ListBox">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ai:AiConversationInteraction.FollowReplies" Value="True"/>
    </Style>
    <DataTemplate x:Key="AiAnalystMessage">
        <Border Background="#EEF4FB" BorderBrush="#D9E3EE" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="36,5,4,5" MaxWidth="720" HorizontalAlignment="Right">
            <StackPanel>
                <TextBlock Text="Analyst" FontWeight="SemiBold" Foreground="#304A65" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent" Padding="0" ai:AiConversationInteraction.PassMouseWheelToTranscript="True"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                <Expander Header="Full prompt submitted to AI" IsExpanded="{Binding IsPromptExpanded, Mode=TwoWay}" Margin="0,8,0,0">
                    <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding HasPromptRequests}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style></Expander.Style>
                    <ai:AiPromptInspectorView LoadCommand="{Binding DataContext.LoadPromptCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                </Expander>                <TextBlock Text="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss}}" FontSize="10" Foreground="#666666" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="AiAssistantMessage">
        <Border Background="#F6F6F6" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="4,5,36,5" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Assistant" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,4"/>
                <ai:AiMarkdownTextBlock Markdown="{Binding Content}" ai:AiConversationInteraction.PassMouseWheelToTranscript="True"/>
                <ItemsControl ItemsSource="{Binding InvestigationTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.RunFollowUpTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="6,4"
                                    AutomationProperties.AutomationId="InvestigationFollowUpTask"
                                    ToolTip="Run this saved task in the current investigation using recorded evidence.">
                                <StackPanel>
                                    <TextBlock Text="{Binding Objective}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Status, StringFormat=Status: {0}}" FontSize="10" Foreground="#666666"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding SuggestedFollowUps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.FollowUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="6,4"
                                    ToolTip="Prepare this question in the composer; edit it and send when ready.">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#666666" Margin="0,5,0,0"/>
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="#A00000"/>
                <Expander Header="Message details" FontSize="10" Foreground="#666666" Margin="0,4,0,0">
                    <StackPanel><ai:AiMarkdownTextBlock Markdown="{Binding TechnicalDetails}"/><TextBlock Text="{Binding TimestampUtc, StringFormat={}{0:O}}"/>
                        <TextBlock Text="{Binding ProviderId, StringFormat=Provider: {0}}"/>
                        <TextBlock Text="{Binding ModelId, StringFormat=Model: {0}}"/>
                        <TextBlock Text="{Binding OriginalProviderKind, StringFormat=Historical provider kind: {0}}"/>
                        <TextBlock Text="{Binding OriginalBaseUrl, StringFormat=Historical endpoint: {0}}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
    </DataTemplate>
    <ai:AiMessageTemplateSelector x:Key="AiMessageTemplates" AnalystTemplate="{StaticResource AiAnalystMessage}" AssistantTemplate="{StaticResource AiAssistantMessage}"/>
</ResourceDictionary>
