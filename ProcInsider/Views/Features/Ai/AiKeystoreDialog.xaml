<Window x:Class="ProcInsider.Views.Features.Ai.AiKeystoreDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="430" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="16">
  <TextBlock x:Name="PasswordLabel" Text="Password"/>
  <PasswordBox x:Name="PasswordInput" Margin="0,4,0,10"/>
  <StackPanel x:Name="NewPasswordPanel"><TextBlock Text="New password"/><PasswordBox x:Name="NewPasswordInput" Margin="0,4,0,10"/></StackPanel>
  <WrapPanel><Button x:Name="ApplyButton" Click="ApplyClicked" Padding="8,4" Margin="0,0,8,0"/><Button Content="Cancel" IsCancel="True" Padding="8,4"/></WrapPanel>
  <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0"/>
 </StackPanel>
</Window>
