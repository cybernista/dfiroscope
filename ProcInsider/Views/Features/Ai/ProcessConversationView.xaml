<UserControl x:Class="ProcInsider.Views.Features.Ai.ProcessConversationView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ai="clr-namespace:ProcInsider.Views.Features.Ai">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="AiConversationResources.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="ProcessTargetVisibility"/></ResourceDictionary></UserControl.Resources>
 <Grid Margin="6">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Expander Header="Chats"><ai:DataProcessConversationView MaxHeight="160"/></Expander>
   <TextBlock Text="Evidence conversation" FontWeight="SemiBold" FontSize="16"/>
   <TextBlock Text="{Binding ProviderDestination}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding TargetSummary}" TextWrapping="Wrap"/>
   <TextBlock Text="Sending submits the exact selected context and checked evidence to this provider. An external endpoint sends data outside this computer." TextWrapping="Wrap" Foreground="#805000"/>
  </StackPanel></ScrollViewer>
  <WrapPanel Grid.Row="1" Margin="0,4">
   <Button Content="Chat about" Command="{Binding ChatAboutCommand}" Margin="0,0,4,0"/>
   <Button Content="Investigate" Command="{Binding InvestigateCommand}" Margin="0,0,4,0">
    <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasInvestigateAction}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
   </Button>
   <Button Content="Review record" Command="{Binding ReviewRecordCommand}" Margin="0,0,4,0"/>
   <Button Content="Find related activity" Command="{Binding FindRelatedActivityCommand}" Margin="0,0,4,0"/>
  </WrapPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="*"/><Style.Triggers><DataTrigger Binding="{Binding ShowEvidenceDetails, RelativeSource={RelativeSource AncestorType=ai:ProcessConversationView}}" Value="False"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition></Grid.ColumnDefinitions>
   <ListBox x:Name="Transcript" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" Style="{StaticResource AiTranscriptStyle}" ItemTemplateSelector="{StaticResource AiMessageTemplates}"/>
   <ai:AiTechnicalDetailsView Grid.Column="1" OpenOriginalCommand="{Binding NavigateReferenceCommand}">
    <ai:AiTechnicalDetailsView.Style><Style TargetType="ai:AiTechnicalDetailsView"><Style.Triggers><DataTrigger Binding="{Binding ShowEvidenceDetails, RelativeSource={RelativeSource AncestorType=ai:ProcessConversationView}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ai:AiTechnicalDetailsView.Style>
   </ai:AiTechnicalDetailsView>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,5,0,0">
   <WrapPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
    <Button Command="{Binding AskCommand}" Margin="0,0,5,0"><Button.Style><Style TargetType="Button"><Setter Property="Content" Value="Send"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Content" Value="Sending…"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" Margin="0,0,5,0"/>
    <Button Content="{Binding CorrectionActionText}" Command="{Binding PrepareCorrectionCommand}"
            Visibility="{Binding HasCorrectionOption, Converter={StaticResource AiCorrectionVisibility}}"
            ToolTip="Prepare an editable follow-up. Only Send contacts the provider." Margin="0,0,5,0"/>
    <Button Content="System prompt" Command="{Binding EditSystemPromptCommand}"/>
   </WrapPanel>
   <TextBox x:Name="Composer" Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="100" VerticalScrollBarVisibility="Auto" IsReadOnly="{Binding IsBusy}" ai:AiConversationInteraction.SendCommand="{Binding AskCommand}" ToolTip="Enter to send; Shift+Enter for a new line"/>
  </DockPanel>
  <StackPanel Grid.Row="4">
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
   <TextBlock Style="{StaticResource AiCorrectionGuidanceStyle}"/>
  </StackPanel>
 </Grid>
</UserControl>
