<UserControl x:Class="ProcInsider.Views.Features.Ai.AiConversationLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ai="clr-namespace:ProcInsider.Views.Features.Ai"
             xmlns:vm="clr-namespace:ProcInsider.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <DataTemplate DataType="{x:Type vm:AiChatViewModel}"><ai:AiChatView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessConversationViewModel}"><ai:ProcessConversationCompactView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvestigationDataViewModel}"><ai:InvestigationConversationView/></DataTemplate>
        <DataTemplate x:Key="GeneralDetails">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Margin="6">
                    <TextBlock Text="{Binding ContextDisplay}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LastSubmittedContext}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ConversationId, StringFormat=Conversation: {0}}" TextWrapping="Wrap"/>
                </StackPanel>
                <ai:AiTechnicalDetailsView Grid.Row="1" OpenOriginalCommand="{Binding OpenCitationCommand}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ObjectDetails">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Margin="6" Text="{Binding ConversationId, StringFormat=Conversation: {0}}" TextWrapping="Wrap"/>
                <ai:AiTechnicalDetailsView Grid.Row="1" OpenOriginalCommand="{Binding NavigateReferenceCommand}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="InvestigationDetails">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Margin="6" Text="{Binding Investigation.Id, StringFormat=Investigation: {0}}" TextWrapping="Wrap"/>
                <ai:AiTechnicalDetailsView Grid.Row="1" OpenOriginalCommand="{Binding NavigateSelectedReferenceCommand}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="ConversationLayout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*" MinWidth="220"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Top" Command="{Binding ToggleTechnicalDetailsCommand, RelativeSource={RelativeSource AncestorType=ai:AiConversationLayoutView}}"
                    HorizontalAlignment="Right" Width="24" Height="24" Padding="4" Margin="0,0,0,4"
                    AutomationProperties.AutomationId="AiTechnicalDetailsToggle">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="ToolTip" Value="Show technical details"/>
                        <Setter Property="AutomationProperties.Name" Value="Show technical details"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TechnicalDetailsVisible, RelativeSource={RelativeSource AncestorType=ai:AiConversationLayoutView}}" Value="True">
                                <Setter Property="ToolTip" Value="Hide technical details"/>
                                <Setter Property="AutomationProperties.Name" Value="Hide technical details"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Path Width="8" Height="14" Stroke="#303030" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="M 7,2 L 2,7 L 7,12"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TechnicalDetailsVisible, RelativeSource={RelativeSource AncestorType=ai:AiConversationLayoutView}}" Value="True">
                                    <Setter Property="Data" Value="M 2,2 L 7,7 L 2,12"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Button>
            <ContentControl Content="{Binding Conversation, RelativeSource={RelativeSource AncestorType=ai:AiConversationLayoutView}}"/>
        </DockPanel>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Visibility="{Binding TechnicalDetailsVisible, RelativeSource={RelativeSource AncestorType=ai:AiConversationLayoutView}, Converter={StaticResource Visible}}"/>
        <ContentControl Grid.Column="2" Content="{Binding Conversation, RelativeSource={RelativeSource AncestorType=ai:AiConversationLayoutView}}"
                        Visibility="{Binding TechnicalDetailsVisible, RelativeSource={RelativeSource AncestorType=ai:AiConversationLayoutView}, Converter={StaticResource Visible}}">
            <ContentControl.ContentTemplateSelector>
                <ai:AiTechnicalTemplateSelector General="{StaticResource GeneralDetails}" Object="{StaticResource ObjectDetails}" Investigation="{StaticResource InvestigationDetails}"/>
            </ContentControl.ContentTemplateSelector>
        </ContentControl>
    </Grid>
</UserControl>
