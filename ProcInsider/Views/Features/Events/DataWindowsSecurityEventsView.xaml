<UserControl x:Class="ProcInsider.Views.Features.Events.DataWindowsSecurityEventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ProcInsider.Views.Shared">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Shared/ColumnHeaderResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding StatusMessage}" Margin="5" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="1" Margin="5">
            <WrapPanel>
                <Button Content="Event profiles" Command="{Binding EditSecurityProfilesCommand}" Margin="0,0,6,0" Padding="8,4"/>
                <ComboBox x:Name="AuditDetailsProfiles" ItemsSource="{Binding MatchingSecurityDetailsProfiles}" SelectedItem="{Binding SecurityDetailsProfile, Mode=TwoWay}" DisplayMemberPath="Name" MinWidth="200" MaxWidth="420" ToolTip="Details profile for the selected event's exact native schema"/>
                <Button x:Name="UseAuditDetailsProfile" Content="Use for Details" Command="{Binding UseSecurityDetailsProfileCommand}" Margin="6,0" Padding="8,4"/>
                <Button Content="Clear Audit Filters" Command="{Binding ClearFiltersCommand}" Padding="8,4"/>
            </WrapPanel>
            <TextBlock Text="{Binding SecurityProfilesStatus}" TextWrapping="Wrap"/>
        </StackPanel>
        <DataGrid x:Name="AuditGrid" Grid.Row="2" Margin="5" FontSize="11"
                  ItemsSource="{Binding EventsView, NotifyOnTargetUpdated=True}" SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                  TargetUpdated="AuditGrid_TargetUpdated" Loaded="AuditGrid_Loaded"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource ColumnFilterHeaderStyle}"
                  CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="145" SortMemberPath="TimestampUtc"/>
                <DataGridTextColumn Header="Event Code" Binding="{Binding EventCodeDisplay}" Width="105" SortMemberPath="EventCode"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="160" SortMemberPath="Description"/>
                <DataGridTextColumn Header="Details" Binding="{Binding DetailsSummary}" Width="2*" MinWidth="200" SortMemberPath="DetailsSummary"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Margin="5,0,5,5" TextWrapping="Wrap">
            <Run Text="Matching rows: "/><Run Text="{Binding VisibleEventCount, Mode=OneWay}" FontWeight="Bold"/>
            <Run Text=" / loaded: "/><Run Text="{Binding LoadedEventCount, Mode=OneWay}" FontWeight="Bold"/>
            <Run Text=" | Filters cover up to 10,000 recent projected rows for the selected process."/>
        </TextBlock>
    </Grid>
</UserControl>
