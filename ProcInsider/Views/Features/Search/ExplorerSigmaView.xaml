<UserControl x:Class="ProcInsider.Views.Features.Search.ExplorerSigmaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid DataContext="{Binding DataContext.SigmaViewModel, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,4">
            <Button Content="Import File"
                    Command="{Binding ImportRuleCommand}"
                    Padding="8,2" Margin="0,0,4,0"/>
            <Button Content="Import Folder"
                    Command="{Binding ImportRuleFolderCommand}"
                    Padding="8,2" Margin="0,0,4,0"/>
            <Button Content="Run"
                    Command="{Binding RunRuleCommand}"
                    Padding="8,2" Margin="0,0,4,0"/>
            <Button Content="Open"
                    Command="{Binding OpenFindingCommand}"
                    Padding="8,2"/>
        </WrapPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding RuleSummary}"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding RulePath}"
                   Margin="0,0,0,4"/>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding RuleDiagnostics}"
                 MaxHeight="80"
                 Margin="0,0,0,4"
                 FontSize="11"
                 Visibility="{Binding HasRuleDiagnostics, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SourcePath}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3">
            <TextBlock Margin="10"
                       Text="{Binding StatusMessage}"
                       Foreground="#666666"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <DataGrid ItemsSource="{Binding FindingsView}"
                      SelectedItem="{Binding SelectedFinding, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      EnableRowVirtualization="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Margin="0"
                      FontSize="11"
                      MouseDoubleClick="SigmaFindingsDataGrid_MouseDoubleClick"
                      Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           Padding="4,3"
                                           Background="#EEEEEE"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding SourceKind}" Width="70"/>
                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="95"/>
                    <DataGridTextColumn Header="Correlation" Binding="{Binding CorrelationState}" Width="85"/>
                    <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding Evidence}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,4,0,0">
            <Button DockPanel.Dock="Right"
                    Content="Clear"
                    Command="{Binding ClearCommand}"
                    Padding="8,2"/>
            <ProgressBar Width="70"
                         Height="14"
                         Margin="0,4,8,0"
                         IsIndeterminate="{Binding IsRunning}"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </DockPanel>
    </Grid>
</UserControl>
