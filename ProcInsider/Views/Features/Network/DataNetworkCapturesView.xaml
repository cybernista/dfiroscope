<UserControl x:Class="ProcInsider.Views.Features.Network.DataNetworkCapturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button Content="Refresh Captures"
                    Command="{Binding RefreshNetworkCapturesCommand}"
                    Padding="10,3" Margin="0,0,10,0"/>
            <TextBlock Text="WSL"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"/>
            <TextBox Width="96"
                     Text="{Binding DataContext.ZeekWslDistributionName, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="WSL distribution for Zeek, such as Ubuntu or Ubuntu-22.04"
                     Margin="0,0,8,0"/>
            <TextBlock Text="Zeek"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"/>
            <TextBox Width="96"
                     Text="{Binding DataContext.ZeekWslCommand, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Zeek command or absolute path inside WSL"
                     Margin="0,0,10,0"/>
            <Button Content="Open Process"
                    Command="{Binding DataContext.OpenSelectedZeekProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="10,3" Margin="0,0,10,0"/>
            <Button Content="Open PCAP"
                    Command="{Binding DataContext.OpenSelectedZeekPcapCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="10,3" Margin="0,0,10,0"/>
            <Button Content="Copy Filter"
                    Command="{Binding DataContext.CopySelectedZeekWiresharkFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="10,3" Margin="0,0,10,0"/>
            <Button Content="Export Flow"
                    Command="{Binding DataContext.ExportSelectedZeekFlowPcapCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="10,3" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="5">
            <TabItem Header="PCAP Segments">
                <DataGrid ItemsSource="{Binding NetworkCapturesView}"
                          SelectedItem="{Binding SelectedNetworkCapture, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Requested" Binding="{Binding RequestedDisplay}" Width="135"
                                            SortMemberPath="RequestedUtc"/>
                        <DataGridTextColumn Header="Segment" Binding="{Binding SegmentIndex}" Width="70"
                                            SortMemberPath="SegmentIndex"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"
                                            SortMemberPath="Status"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding FileSizeDisplay}" Width="85"
                                            SortMemberPath="FileSizeBytes"/>
                        <DataGridTextColumn Header="PCAPNG Path" Binding="{Binding FilePath}" Width="320"
                                            SortMemberPath="FilePath">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="SHA256" Binding="{Binding Sha256Hash}" Width="220"
                                            SortMemberPath="Sha256Hash">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Sha256Hash}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ETL Path" Binding="{Binding EtlFilePath}" Width="260"
                                            SortMemberPath="EtlFilePath">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding EtlFilePath}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="260"
                                            SortMemberPath="ErrorMessage">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Zeek Artifacts">
                <DataGrid ItemsSource="{Binding ZeekArtifactsView}"
                          SelectedItem="{Binding SelectedZeekArtifact, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding TimestampDisplay}" Width="135"
                                            SortMemberPath="TimestampUtc"/>
                        <DataGridTextColumn Header="Log" Binding="{Binding LogType}" Width="80"
                                            SortMemberPath="LogType"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"
                                            SortMemberPath="Status"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding SourceEndpoint}" Width="150"
                                            SortMemberPath="SourceEndpoint"/>
                        <DataGridTextColumn Header="Destination" Binding="{Binding DestinationEndpoint}" Width="160"
                                            SortMemberPath="DestinationEndpoint"/>
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"
                                            SortMemberPath="Protocol"/>
                        <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="90"
                                            SortMemberPath="Service"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="90"
                                            SortMemberPath="DurationSeconds"/>
                        <DataGridTextColumn Header="Sent" Binding="{Binding OrigBytesDisplay}" Width="90"
                                            SortMemberPath="OrigBytes"/>
                        <DataGridTextColumn Header="Received" Binding="{Binding RespBytesDisplay}" Width="95"
                                            SortMemberPath="RespBytes"/>
                        <DataGridTextColumn Header="State" Binding="{Binding ConnectionState}" Width="80"
                                            SortMemberPath="ConnectionState"/>
                        <DataGridTextColumn Header="History" Binding="{Binding History}" Width="90"
                                            SortMemberPath="History"/>
                        <DataGridTextColumn Header="DNS Query" Binding="{Binding DnsQuery}" Width="180"
                                            SortMemberPath="DnsQuery"/>
                        <DataGridTextColumn Header="HTTP Host" Binding="{Binding HttpHost}" Width="180"
                                            SortMemberPath="HttpHost"/>
                        <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="180"
                                            SortMemberPath="ServerName">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding ServerName}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="280"
                                            SortMemberPath="Summary">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Summary}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="140"
                                            SortMemberPath="ProcessName"/>
                        <DataGridTextColumn Header="Correlation" Binding="{Binding CorrelationDisplay}" Width="230"
                                            SortMemberPath="CorrelationDisplay"/>
                        <DataGridTextColumn Header="Raw Log" Binding="{Binding RawLogPath}" Width="260"
                                            SortMemberPath="RawLogPath">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding RawLogPath}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Margin="5,0,5,5">
            <Run Text="Network capture segments: "/>
            <Run Text="{Binding NetworkCaptures.Count, Mode=OneWay}" FontWeight="Bold"/>
            <Run Text=" | Zeek artifacts: "/>
            <Run Text="{Binding ZeekArtifacts.Count, Mode=OneWay}" FontWeight="Bold"/>
        </TextBlock>
    </Grid>
</UserControl>
