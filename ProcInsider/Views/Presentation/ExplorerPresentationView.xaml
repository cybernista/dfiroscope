<UserControl x:Class="ProcInsider.Views.Presentation.ExplorerPresentationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProcInsider"
        xmlns:models="clr-namespace:ProcInsider.Models;assembly=DFIRoscope.Core"
        xmlns:viewerModels="clr-namespace:ProcInsider.Models"
        xmlns:vm="clr-namespace:ProcInsider.ViewModels"
        xmlns:converters="clr-namespace:ProcInsider.Converters"
        xmlns:aiViews="clr-namespace:ProcInsider.Views.Features.Ai"
        xmlns:memoryViews="clr-namespace:ProcInsider.Views.Features.Memory"
        xmlns:networkViews="clr-namespace:ProcInsider.Views.Features.Network"
        xmlns:infrastructureViews="clr-namespace:ProcInsider.Features.Infrastructure"
        xmlns:explorerViews="clr-namespace:ProcInsider.Views.Explorer"
        xmlns:agentViews="clr-namespace:ProcInsider.Views.Features.Agents"
        xmlns:searchViews="clr-namespace:ProcInsider.Views.Features.Search"
        xmlns:shared="clr-namespace:ProcInsider.Views.Shared"
        xmlns:presentationViews="clr-namespace:ProcInsider.Views.Presentation"
        xmlns:presentation="clr-namespace:ProcInsider.Services.Presentation"
        presentation:ViewerPresentationContext.SharedActions="{Binding SharedActions}"
        mc:Ignorable="d">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ViewerPresentationResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>

<Border
                    BorderBrush="#FFD0D0D0"
                    BorderThickness="0,0,1,0"
                    Background="#FFFAFAFA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFE8E8E8" Padding="7,4">
                        <TextBlock Text="Explorer"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <TabControl Grid.Row="1"
                                 ItemsSource="{Binding ExplorerTabs}"
                                 SelectedItem="{Binding SelectedExplorerTab, Mode=TwoWay}"
                                 Margin="4">
                        <TabControl.Resources>
                            <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
                                <explorerViews:ExploreView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:AgentsViewModel}">
                                <agentViews:ExplorerAgentsView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SigmaViewModel}">
                                <searchViews:ExplorerSigmaView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:ProcessPresentationViewModel}">
                                <aiViews:ExplorerAiView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:NetworkCapturesViewModel}">
                                <networkViews:ExplorerNetworkView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:MemoryInvestigationViewModel}">
                                <memoryViews:ExplorerMemoryView/>
                            </DataTemplate>
                        </TabControl.Resources>
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Header}"/>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding Content}"/>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>

                    <TextBlock Grid.Row="2"
                               Text="{Binding ExplorerViewModel.StatusMessage}"
                               Padding="6,4"
                               Foreground="#555555"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>
</UserControl>
