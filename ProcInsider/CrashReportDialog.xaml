<Window x:Class="ProcInsider.CrashReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viewer encountered a fatal error"
        Width="720"
        MinWidth="560"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Topmost="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Text="The viewer must close after an unexpected failure." />

        <TextBlock x:Name="SummaryText"
                   Grid.Row="1"
                   Margin="0,10,0,12"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,3,10,3" FontWeight="SemiBold" Text="Incident ID" />
            <TextBox x:Name="IncidentIdText" Grid.Row="0" Grid.Column="1" Margin="0,2" IsReadOnly="True" />
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,3,10,3" FontWeight="SemiBold" Text="Diagnostic file" />
            <TextBox x:Name="DiagnosticPathText" Grid.Row="1" Grid.Column="1" Margin="0,2" IsReadOnly="True" />
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,3,10,3" FontWeight="SemiBold" Text="Entry point" />
            <TextBox x:Name="EntryPointText" Grid.Row="2" Grid.Column="1" Margin="0,2" IsReadOnly="True" />
        </Grid>

        <TextBox x:Name="DetailsText"
                 Grid.Row="3"
                 Margin="0,12,0,0"
                 MinHeight="110"
                 MaxHeight="260"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
            <TextBlock x:Name="CopyStatusText"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="#FF555555" />
            <Button DockPanel.Dock="Right" Width="88" Margin="8,0,0,0" Padding="8,4" IsDefault="True" Click="Close_Click">Close</Button>
            <Button DockPanel.Dock="Right" Width="110" Padding="8,4" Click="CopyDetails_Click">Copy details</Button>
        </DockPanel>
    </Grid>
</Window>
