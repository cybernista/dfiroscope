<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The current compiled release publishes Windows Security. Explicit hidden-profile tests
         may still pass PublishWindowsSecurityEvents=false to prove asset exclusion. -->
    <PublishWindowsSecurityEvents Condition="'$(PublishWindowsSecurityEvents)' == ''">true</PublishWindowsSecurityEvents>

    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildThisFileDirectory)=/_/</PathMap>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <RepositoryUrl>https://github.com/tomek4624/ProcInsider</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)build\Licensing.props"
          Condition="'$(DFIRoscopeEdition)' != 'S1E1'" />
</Project>
