<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Operational event assets are an output contract, not an activation mechanism. The
         current compiled M2 profile publishes Windows Security plus both retained aggregate owners.
         Non-Security assets still require both aggregates so a partial candidate cannot ship host-monitoring data. -->
    <PublishWindowsSecurityEvents Condition="'$(PublishWindowsSecurityEvents)' == ''">true</PublishWindowsSecurityEvents>
    <PublishEventTelemetry Condition="'$(PublishEventTelemetry)' == ''">true</PublishEventTelemetry>
    <PublishSecurityMonitoringConfiguration Condition="'$(PublishSecurityMonitoringConfiguration)' == ''">true</PublishSecurityMonitoringConfiguration>
    <!-- Focused package matrices may isolate every referenced project's outputs under one
         guarded external root. Normal product builds retain their established output paths. -->
    <DefaultItemExcludes Condition="'$(DFIRoscopeValidationOutputRoot)' != ''">$(DefaultItemExcludes);bin\**;obj\**;$(DFIRoscopeValidationOutputRoot)\**</DefaultItemExcludes>
    <BaseIntermediateOutputPath Condition="'$(DFIRoscopeValidationOutputRoot)' != ''">$(DFIRoscopeValidationOutputRoot)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(DFIRoscopeValidationOutputRoot)' != ''">$(DFIRoscopeValidationOutputRoot)\bin\$(MSBuildProjectName)\</BaseOutputPath>

    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildThisFileDirectory)=/_/</PathMap>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <RepositoryUrl>https://github.com/tomek4624/ProcInsider</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)build\Licensing.props"
          Condition="'$(DFIRoscopeEdition)' != 'S1E1'" />
</Project>
