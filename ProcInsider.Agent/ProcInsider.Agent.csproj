<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>DFIRoscope.Agent</AssemblyName>
    <RootNamespace>ProcInsider.Agent</RootNamespace>
    <AssemblyTitle>DFIRoscope Live Agent</AssemblyTitle>
    <Product>DFIRoscope Live</Product>
    <Description>Local evidence capture and analysis agent for DFIRoscope Live.</Description>
    <LegacyAssemblyName>ProcInsider.Agent</LegacyAssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProcInsider.Core\ProcInsider.Core.csproj" />
    <ProjectReference Include="..\ProcInsider.Infrastructure.Windows\ProcInsider.Infrastructure.Windows.csproj" />
  </ItemGroup>

  <Target Name="EnforceAgentApplicationProjectBoundary" BeforeTargets="ResolveProjectReferences">
    <ItemGroup>
      <_ForbiddenAgentApplicationProjectReference
        Include="@(ProjectReference)"
        Condition="'%(ProjectReference.Filename)' == 'ProcInsider' Or '%(ProjectReference.Filename)' == 'DFIRoscope.Live'" />
    </ItemGroup>
    <Error
      Condition="'@(_ForbiddenAgentApplicationProjectReference)' != ''"
      Code="ARCH019"
      Text="ARCH019 Agent application boundary: DFIRoscope.Agent must not reference the viewer project. Reference only DFIRoscope.Core and DFIRoscope.Infrastructure.Windows." />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentConfigurationSelfTest" />
    <InternalsVisibleTo Include="AgentServiceHostSelfTest" />
    <InternalsVisibleTo Include="InfrastructureSessionProtocolSelfTest" />
    <InternalsVisibleTo Include="InfrastructureHttp2CarrierSelfTest" />
    <InternalsVisibleTo Include="InfrastructureVmIntegratedSelfTest" />
    <InternalsVisibleTo Include="InfrastructureCommandRoutingSelfTest" />
    <InternalsVisibleTo Include="InfrastructureEvidenceTransferSelfTest" />
    <InternalsVisibleTo Include="InfrastructureEvidenceOutboxSelfTest" />
    <InternalsVisibleTo Include="AgentInfrastructureRuntimeSelfTest" />
    <InternalsVisibleTo Include="AgentYaraExecutionSelfTest" />
  </ItemGroup>

  <ItemGroup>
    <Content
      Include="..\ProcInsider\Config\**\*.*"
      Exclude="..\ProcInsider\Config\ApplicationCatalog\catalog.index.json;..\ProcInsider\Config\ApplicationCatalog\Profiles\**\*.json;..\ProcInsider\Config\ApplicationCatalog\catalog-quality.v1.json;..\ProcInsider\Config\ApplicationCatalog\README.md;..\ProcInsider\Config\WindowsSecurity\**\*.*;..\ProcInsider\Config\Etw\**\*.*;..\ProcInsider\Config\etw-providers.json;..\ProcInsider\Config\EventLogs\**\*.*;..\ProcInsider\Config\PowerShellAuditing\**\*.*;..\ProcInsider\Config\SecurityMonitoring\**\*.*;..\ProcInsider\Config\Sysmon\**\*.*"
      LinkBase="Config"
      CopyToOutputDirectory="PreserveNewest" />
    <Content
      Include="..\ProcInsider\Config\WindowsSecurity\**\*.*"
      Link="Config\WindowsSecurity\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      Condition="'$(PublishWindowsSecurityEvents)' == 'true'" />
    <Content
      Include="..\ProcInsider\Config\Etw\**\*.*"
      Link="Config\Etw\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      Condition="'$(PublishEventTelemetry)' == 'true' And '$(PublishSecurityMonitoringConfiguration)' == 'true'" />
    <Content
      Include="..\ProcInsider\Config\etw-providers.json"
      Link="Config\etw-providers.json"
      CopyToOutputDirectory="PreserveNewest"
      Condition="'$(PublishEventTelemetry)' == 'true' And '$(PublishSecurityMonitoringConfiguration)' == 'true'" />
    <Content
      Include="..\ProcInsider\Config\EventLogs\**\*.*"
      Link="Config\EventLogs\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      Condition="'$(PublishEventTelemetry)' == 'true' And '$(PublishSecurityMonitoringConfiguration)' == 'true'" />
    <Content
      Include="..\ProcInsider\Config\PowerShellAuditing\**\*.*"
      Link="Config\PowerShellAuditing\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      Condition="'$(PublishEventTelemetry)' == 'true' And '$(PublishSecurityMonitoringConfiguration)' == 'true'" />
    <Content
      Include="..\ProcInsider\Config\SecurityMonitoring\**\*.*"
      Link="Config\SecurityMonitoring\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      Condition="'$(PublishEventTelemetry)' == 'true' And '$(PublishSecurityMonitoringConfiguration)' == 'true'" />
    <Content
      Include="..\ProcInsider\Config\Sysmon\**\*.*"
      Link="Config\Sysmon\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      Condition="'$(PublishEventTelemetry)' == 'true' And '$(PublishSecurityMonitoringConfiguration)' == 'true'" />
    <Content
      Include="..\ProcInsider\Sysmon\**\*.*"
      Link="Sysmon\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      Condition="'$(PublishEventTelemetry)' == 'true' And '$(PublishSecurityMonitoringConfiguration)' == 'true'" />
  </ItemGroup>

  <Import Project="..\build\ExecutableCompatibilityAliases.targets" />

</Project>
